---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = "muxin.space | 木辛时刻",
  description = "分享项目实践、技术整理与真实成长的个人内容主站。",
  image = "/og-cover.svg",
  type = "website",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteImage = new URL(image, Astro.site).toString();

const navLinks = [
  { href: "/", label: "Home", wanderHref: "/wander/", wanderLabel: "起点" },
  { href: "/notes", label: "Sharing", wanderHref: "/wander/anime/", wanderLabel: "番剧" },
  { href: "/portfolio", label: "Portfolio", wanderHref: "/wander/photos/", wanderLabel: "摄影" },
  { href: "/resume", label: "Resume", wanderHref: "/wander/notes/", wanderLabel: "随笔" },
  { href: "/memo", label: "🪵 小木", wanderHref: "/memo", wanderLabel: "小木电台" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfbfa" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="muxin.space" href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content="muxin.space" />
    <meta property="og:locale" content="zh_CN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <title>{title}</title>
  </head>
  <body class="font-sans text-zinc-900">
    <header class="border-b border-zinc-200/70 bg-[#fbfbfa]/95 backdrop-blur-xl">
      <div class="mx-auto flex w-full max-w-[1600px] items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-10">
        <a href="/" class="inline-flex items-center gap-1.5 font-serif text-lg tracking-tight text-zinc-900 shrink-0">
          <span>muxin</span>
          <span class="text-zinc-400">/</span>
          <span>space</span>
        </a>

        <nav aria-label="主导航" class="min-w-0 overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          <ul class="flex items-center gap-0.5 text-[13px] sm:text-sm font-medium text-zinc-500">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    data-site-mode-link
                    data-career-href={link.href}
                    data-wander-href={link.wanderHref}
                    data-astro-prefetch
                    aria-current={isActive(link.href) ? "page" : undefined}
                    class:list={[
                      "whitespace-nowrap rounded-full px-2.5 py-1.5 sm:px-3.5 sm:py-2 transition-colors duration-200 hover:text-zinc-900",
                      isActive(link.href) ? "bg-zinc-900 text-white hover:text-white" : "",
                    ]}
                  >
                    <span data-site-mode-label data-career-label={link.label} data-wander-label={link.wanderLabel}>{link.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="hidden shrink-0 items-center gap-1 rounded-full border border-zinc-200 bg-white p-1 text-[11px] sm:flex" data-site-mode-switch>
          <button type="button" data-site-mode-button="career" class="rounded-full bg-zinc-900 px-2.5 py-1 font-medium text-white">工作台</button>
          <button type="button" data-site-mode-button="wander" class="rounded-full px-2.5 py-1 font-medium text-zinc-500 transition hover:text-zinc-900">漫游</button>
        </div>
      </div>
    </header>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-sm focus:text-white">
      跳到主要内容
    </a>

    <main id="main-content" class="mx-auto w-full max-w-[1600px] px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
      <slot />
    </main>

    <footer class="border-t border-zinc-200/70">
      <div class="mx-auto flex w-full max-w-[1600px] flex-col gap-5 px-4 py-8 text-sm text-zinc-400 sm:px-6 lg:px-10 md:flex-row md:items-center md:justify-between">
        <p>Built with Astro + Tailwind CSS</p>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <a href="/about/" class="transition hover:text-zinc-900">About</a>
          <a href="/now/" class="transition hover:text-zinc-900">Now</a>
          <a href="/projects/" class="transition hover:text-zinc-900">Projects</a>
          <a href="mailto:hello@muxin-space.top" class="transition hover:text-zinc-900">Contact</a>
          <span>{new Date().getFullYear()} muxin.space</span>
        </div>
      </div>
    </footer>

    <script>
      import { getWanderStorage, readStorageValue, readVisitedProgress, recordRecentProgress, writeStorageValue, writeVisitedProgress } from "../utils/wander-storage";
      import { getSiteModeSyncState, isSiteModeStorageKey, resolveSiteMode } from "../utils/site-mode";

      function initReveal() {
        const targets = document.querySelectorAll<HTMLElement>(".reveal");
        if (!targets.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );

        targets.forEach((el, index) => {
          el.style.transitionDelay = `${Math.min(index * 60, 300)}ms`;
          observer.observe(el);
        });
      }

      function initSiteMode() {
        const root = document.querySelector<HTMLElement>("[data-site-mode-switch]");
        const buttons = document.querySelectorAll<HTMLButtonElement>("[data-site-mode-button]");
        const labels = document.querySelectorAll<HTMLElement>("[data-site-mode-label]");
        const links = document.querySelectorAll<HTMLAnchorElement>("[data-site-mode-link]");
        if (document.documentElement.dataset.siteModeReady === "true") return;

        const setMode = (mode: string, broadcast = true) => {
          const normalizedMode = getSiteModeSyncState(mode).navigationMode;
          document.documentElement.dataset.siteMode = normalizedMode;
          buttons.forEach((button) => {
            const active = button.dataset.siteModeButton === normalizedMode;
            button.classList.toggle("bg-zinc-900", active && normalizedMode === "career");
            button.classList.toggle("text-white", active && normalizedMode === "career");
            button.classList.toggle("bg-violet-600", active && normalizedMode === "wander");
            button.classList.toggle("text-zinc-500", !active);
          });
          labels.forEach((label) => {
            label.textContent = normalizedMode === "wander" ? label.dataset.wanderLabel ?? label.textContent : label.dataset.careerLabel ?? label.textContent;
          });
          links.forEach((link) => {
            link.href = normalizedMode === "wander" ? link.dataset.wanderHref ?? link.dataset.careerHref ?? link.href : link.dataset.careerHref ?? link.href;
          });
          const storage = getWanderStorage();
          if (readStorageValue(storage, "muxin-site-mode") !== normalizedMode) writeStorageValue(storage, "muxin-site-mode", normalizedMode);
          if (broadcast) window.dispatchEvent(new CustomEvent("muxin:mode-change", { detail: normalizedMode }));
        };

        buttons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.siteModeButton ?? "career")));
        window.addEventListener("muxin:mode-change", (event) => {
          const mode = (event as CustomEvent<string>).detail;
          if (mode) setMode(mode, false);
        });
        window.addEventListener("storage", (event) => {
          if (isSiteModeStorageKey(event.key)) setMode(event.newValue ?? "career");
        });
        const storage = getWanderStorage();
        setMode(resolveSiteMode(readStorageValue(storage, "muxin-site-mode"), readStorageValue(storage, "muxin-home-mode")));
        document.documentElement.dataset.siteModeReady = "true";
        if (root) root.dataset.ready = "true";
      }

      function initWanderFootprints() {
        const path = window.location.pathname.replace(/\/+$/, "") || "/";
        const paths: Record<string, string> = {
          "/wander/anime": "anime",
          "/wander/photos": "photo",
          "/wander/notes": "notes",
          "/memo": "memo",
        };
        const key = paths[path];
        if (!key) return;
        const visitedKey = "muxin-wander-visited";
        const recentKey = "muxin-wander-recent";
        try {
          const storage = getWanderStorage();
          const visited = readVisitedProgress(storage, visitedKey);
          visited.add(key);
          writeVisitedProgress(storage, visitedKey, visited);
          recordRecentProgress(storage, recentKey, key);
          window.dispatchEvent(new CustomEvent("muxin-wander-progress"));
        } catch {
        }
      }

      initReveal();
      initSiteMode();
      initWanderFootprints();
      document.addEventListener("astro:page-load", initReveal);
      document.addEventListener("astro:page-load", initSiteMode);
      document.addEventListener("astro:page-load", initWanderFootprints);
    </script>
  </body>
</html>

<style is:global>
  html[data-site-mode="wander"] body {
    background: #17131f;
    color: #f4f0ff;
  }

  html[data-site-mode="wander"] header,
  html[data-site-mode="wander"] footer {
    border-color: rgba(139, 92, 246, 0.25);
    background: rgba(23, 19, 31, 0.92);
  }

  html[data-site-mode="wander"] .text-zinc-900 { color: #f4f0ff !important; }
  html[data-site-mode="wander"] .text-zinc-700,
  html[data-site-mode="wander"] .text-zinc-600 { color: #d8cfea !important; }
  html[data-site-mode="wander"] .text-zinc-500,
  html[data-site-mode="wander"] .text-zinc-400 { color: #9d91b5 !important; }
  html[data-site-mode="wander"] .border-zinc-200,
  html[data-site-mode="wander"] .border-zinc-300 { border-color: rgba(139, 92, 246, 0.28) !important; }
  html[data-site-mode="wander"] .bg-white { background: #241d30 !important; }
  html[data-site-mode="wander"] .bg-zinc-50 { background: #1e1828 !important; }
  html[data-site-mode="wander"] .bg-zinc-900 { background: #0e0b14 !important; }
  html[data-site-mode="wander"] .tag { border-color: rgba(167, 139, 250, 0.35); background: #2b2239; color: #d8cfea; }
  html[data-site-mode="wander"] [data-site-mode-switch] { border-color: rgba(139, 92, 246, 0.35); background: #241d30; }
  html[data-site-mode="wander"] [data-site-mode-button="career"] { background: transparent; color: #9d91b5; }
  html[data-site-mode="wander"] [data-site-mode-button="wander"] { background: #7c3aed; color: white; }
  html[data-site-mode="wander"] [data-site-mode-label] { letter-spacing: 0.01em; }

  @media (max-width: 639px) {
    html[data-site-mode="wander"] body::before {
      content: "漫游模式";
      position: fixed;
      right: 12px;
      bottom: 12px;
      z-index: 40;
      border: 1px solid rgba(167, 139, 250, 0.4);
      border-radius: 999px;
      background: rgba(36, 29, 48, 0.92);
      padding: 6px 10px;
      color: #c4b5fd;
      font-size: 10px;
      pointer-events: none;
    }
  }
</style>
