---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在 | muxin.space" description="你访问的页面不存在。">
  <section class="mx-auto flex max-w-3xl flex-col items-center rounded-2xl border border-zinc-200 bg-white px-6 py-16 text-center sm:px-10">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-serif text-4xl tracking-tight text-zinc-900">这个页面还没被写出来。</h1>
    <p class="mt-4 max-w-xl text-base leading-8 text-zinc-500">
      你可以先回到首页，或者直接去分享页看看最近公开整理的内容。
    </p>

    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-full bg-zinc-900 px-6 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700"
      >
        返回首页
      </a>
      <a
        href="/notes/"
        class="inline-flex items-center rounded-full border border-zinc-300 px-6 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-500"
      >
        去看分享
      </a>
    </div>
  </section>
</BaseLayout>
