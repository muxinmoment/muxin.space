---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = (await getCollection("wander", ({ data }) => !data.draft && data.type === "anime")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="番剧书架 | 漫游" description="把看过的故事放回自己的书架。">
  <div class="anime-library mx-auto max-w-5xl">
    <a href="/wander/" class="text-sm text-zinc-500 hover:text-violet-600">← 回到漫游</a>
    <header class="mt-10 flex flex-col gap-5 border-b border-violet-200 pb-10 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="eyebrow text-violet-500">Anime bookshelf</p><h1 class="mt-3 font-serif text-5xl tracking-tight text-zinc-900">番剧书架</h1><p class="mt-4 max-w-2xl text-base leading-8 text-zinc-500">不做排行榜。每一部作品都是一本被翻过的书，记录它在某个时刻碰到我的地方。</p></div>
      <span class="tag-accent border-violet-200 bg-violet-50 text-violet-700">{entries.length} 本记录</span>
    </header>

    <section class="mt-10 rounded-[2rem] bg-[#21172e] p-5 shadow-xl shadow-violet-950/10 sm:p-8">
      <div class="mb-6 flex items-center justify-between text-violet-200"><p class="text-xs font-semibold uppercase tracking-[0.18em]">The shelf</p><span class="text-xs text-violet-300/60">随时可以再放一本进去</span></div>
      <div class="bookshelf-grid">
        {entries.length ? entries.map((entry, index) => <a href={`/wander/${entry.id}/`} class="book-card group" style={`--book-color: ${["#c084fc", "#fb7185", "#fbbf24", "#34d399", "#60a5fa"][index % 5]}`}><div class="book-spine"><span>{entry.data.title.slice(0, 1)}</span></div><div class="book-info"><p class="text-[10px] uppercase tracking-[0.16em] text-violet-300/60">{entry.data.pubDate.toISOString().slice(0, 10)}</p><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div></a>) : Array.from({ length: 6 }, (_, index) => <div class="empty-book" style={`--empty-index: ${index}`}><span>未命名</span><small>待放入真实记录</small></div>)}
      </div>
      {!entries.length && <div class="mt-8 rounded-2xl border border-dashed border-violet-300/30 bg-white/[0.04] p-6 text-center"><p class="text-2xl">📚</p><p class="mt-3 font-serif text-xl text-white">书架已经搭好了</p><p class="mt-2 text-sm leading-7 text-violet-100/60">等你放入第一部真正想写的番。这里不会用虚构的观后感填满。</p></div>}
    </section>
  </div>
</BaseLayout>

<style>
  .bookshelf-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; align-items: stretch; border-bottom: 8px solid #6b442b; padding-bottom: 1rem; background: repeating-linear-gradient(90deg, transparent 0 3px, rgba(255,255,255,.025) 3px 5px); }
  .book-card { display: grid; grid-template-columns: 2.8rem 1fr; min-height: 150px; overflow: hidden; border: 1px solid rgba(196,181,253,.18); border-radius: 1rem; background: rgba(255,255,255,.07); transition: transform .3s, background .3s, border-color .3s; }
  .book-card:hover { transform: translateY(-6px) rotate(-1deg); border-color: var(--book-color); background: rgba(255,255,255,.12); }
  .book-spine { display: grid; place-items: center; background: var(--book-color); color: #21172e; writing-mode: vertical-rl; font-family: var(--font-serif); font-size: 1.1rem; font-weight: 700; }
  .book-info { padding: 1rem; color: white; }
  .book-info h2 { margin-top: .5rem; font-family: var(--font-serif); font-size: 1.2rem; }
  .book-info p:last-child { margin-top: .45rem; color: rgba(237,233,254,.6); font-size: .78rem; line-height: 1.6; }
  .empty-book { display: grid; min-height: 150px; place-items: center; align-content: center; gap: .4rem; border: 1px dashed rgba(196,181,253,.22); border-radius: 1rem; color: rgba(221,214,254,.45); transform: rotate(calc((var(--empty-index) - 2) * .5deg)); }
  .empty-book span { font-family: var(--font-serif); font-size: 1rem; }
  .empty-book small { font-size: .68rem; }
</style>
