---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = (await getCollection("wander", ({ data }) => !data.draft && data.type === "essay")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="支线随笔 | 漫游" description="和工程无关，但和我有关的随笔。">
  <div class="mx-auto max-w-4xl">
    <a href="/wander/" class="text-sm text-zinc-500 hover:text-amber-600">← 回到漫游</a>
    <header class="mt-10 border-b border-amber-200 pb-10"><p class="eyebrow text-amber-600">Side notes</p><h1 class="mt-3 font-serif text-5xl tracking-tight text-zinc-900">支线随笔</h1><p class="mt-4 max-w-2xl text-base leading-8 text-zinc-500">关于游戏、生活、审美，以及那些不需要被归档成“有用”的时刻。这里没有模板文章，只有真正想留下来的片段。</p></header>
    <section class="note-desk mt-10">
      <div class="note-desk-label">小桌面 · 支线写作区</div>
      {entries.length ? entries.map((entry) => <a href={`/wander/${entry.id}/`} class="note-paper"><p class="eyebrow text-amber-700">{entry.data.pubDate.toISOString().slice(0, 10)}</p><h2>{entry.data.title}</h2><p>{entry.data.description}</p><span>打开这页 →</span></a>) : <div class="note-paper empty-note"><p class="text-3xl">✦</p><h2>这里还没有第一张纸。</h2><p>支线随笔目前没有公开文章。之前的模板被标记为草稿，所以页面显示“尚未解锁”——不是入口丢了，而是在等真实的生活片段。</p><div class="note-line"></div><small>等一个值得写下来的瞬间。</small></div>}
      <div class="note-pencil" aria-hidden="true"></div>
    </section>
  </div>
</BaseLayout>

<style>
  .note-desk { position: relative; min-height: 340px; overflow: hidden; border-radius: 2rem; background: linear-gradient(135deg, #92400e, #b45309 50%, #78350f); padding: 2rem; box-shadow: inset 0 1px rgba(255,255,255,.2), 0 22px 40px rgba(146,64,14,.14); }
  .note-desk::before { position: absolute; inset: 0; background: repeating-linear-gradient(100deg, transparent 0 18px, rgba(255,255,255,.035) 19px 20px); content: ""; }
  .note-desk-label { position: relative; color: rgba(255,237,213,.7); font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; }
  .note-paper { position: relative; display: block; max-width: 650px; margin: 1.5rem auto 0; border: 1px solid #fde68a; background: #fffbeb; padding: 2rem; color: #451a03; box-shadow: 8px 10px 0 rgba(69,26,3,.15); transform: rotate(-1deg); transition: transform .3s, box-shadow .3s; }
  .note-paper:hover { transform: rotate(0) translateY(-5px); box-shadow: 8px 16px 0 rgba(69,26,3,.15); }
  .note-paper h2 { margin-top: .8rem; font-family: var(--font-serif); font-size: 1.7rem; }
  .note-paper > p:not(.eyebrow) { margin-top: .7rem; color: #92400e; font-size: .85rem; line-height: 1.8; }
  .note-paper > span { display: block; margin-top: 1.5rem; color: #b45309; font-size: .75rem; font-weight: 600; }
  .empty-note { text-align: center; }
  .empty-note h2 { font-size: 1.8rem; }
  .empty-note p:not(.eyebrow) { max-width: 34rem; margin-right: auto; margin-left: auto; }
  .note-line { max-width: 26rem; margin: 1.5rem auto 0; border-bottom: 1px dashed #f59e0b; }
  .empty-note small { display: block; margin-top: .8rem; color: #b45309; font-size: .72rem; }
  .note-pencil { position: absolute; right: 8%; bottom: -3rem; width: 12rem; height: 1.2rem; border-radius: 999px; background: #fbbf24; box-shadow: 0 3px 0 #92400e; transform: rotate(-12deg); }
  @media (max-width: 640px) { .note-desk { padding: 1.2rem; } .note-paper { padding: 1.4rem; } .note-pencil { right: -2rem; } }
</style>
