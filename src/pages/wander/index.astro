---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WanderRoom3D from "../../components/WanderRoom3D.astro";

const entries = (await getCollection("wander", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const counts = {
  anime: entries.filter((entry) => entry.data.type === "anime").length,
  photo: entries.filter((entry) => entry.data.type === "photo").length,
  essay: entries.filter((entry) => entry.data.type === "essay").length,
};
---

<BaseLayout title="漫游 | muxin.space" description="番剧、摄影和不太正经的个人支线。">
  <div class="wander-room-ui mx-auto max-w-6xl" data-wander-room data-scene="dusk">
    <WanderRoom3D
      eyebrow="Wander room · personal space"
      title="欢迎来到我的私人支线。"
      intro="这里不负责证明我会什么，只负责留下我喜欢什么。番剧、摄影、游戏和一些没有 KPI 的念头，都可以在这里找到位置。"
    />

    <div class="wander-toolbar">
      <div class="wander-scene-switch" role="group" aria-label="切换房间时间">
        <span class="wander-scene-switch-label">房间时间</span>
        <button type="button" data-scene-button="auto" aria-pressed="true" class="wander-scene-btn">跟随时间</button>
        <button type="button" data-scene-button="dawn" aria-pressed="false" class="wander-scene-btn">清晨</button>
        <button type="button" data-scene-button="day" aria-pressed="false" class="wander-scene-btn">午后</button>
        <button type="button" data-scene-button="dusk" aria-pressed="false" class="wander-scene-btn">黄昏</button>
        <button type="button" data-scene-button="night" aria-pressed="false" class="wander-scene-btn">夜晚</button>
      </div>
      <p class="wander-toolbar-note"><span data-scene-text>黄昏，光线正好</span> · <span data-room-status class="wander-room-status">开放参观</span><span data-room-status-copy>从一个入口开始逛</span></p>
    </div>

    <section class="wander-directory mt-8 rounded-3xl border border-violet-300/20 bg-white/[0.04] p-6 backdrop-blur-sm sm:p-8" data-wander-directory aria-labelledby="wander-directory-title">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow text-violet-300">Room directory</p>
          <h2 id="wander-directory-title" class="mt-3 font-serif text-3xl leading-tight text-white">不进房间，也可以从这里开始。</h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-violet-100/60">漫游空间的文字目录。用 Tab 浏览，或按 1–4 直接聚焦一条支线；访问过的入口会在本机留下进度。</p>
        </div>
        <p class="shrink-0 text-sm text-violet-100/50"><span data-wander-progress class="font-medium text-amber-200">0 / 4</span> 已探索</p>
      </div>
      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="漫游章节目录">
        <a href="/wander/anime/" data-wander-link data-wander-key="anime" data-wander-shortcut="1" class="wander-link group flex items-center justify-between rounded-2xl border border-violet-300/25 bg-violet-400/10 p-4 transition duration-200 hover:-translate-y-0.5 hover:border-violet-300/60 hover:bg-violet-400/20 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:ring-offset-2 focus:ring-offset-[#17131f]">
          <span class="flex items-center gap-3"><span class="text-2xl" aria-hidden="true">📺</span><span><span class="block text-xs text-violet-200/50">01 · {counts.anime} records</span><strong class="mt-1 block text-white">番剧书架</strong></span></span><span class="flex items-center gap-2 text-violet-300"><span data-wander-visited-label class="text-[.65rem] font-medium"></span><span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/wander/photos/" data-wander-link data-wander-key="photo" data-wander-shortcut="2" class="wander-link group flex items-center justify-between rounded-2xl border border-rose-300/20 bg-rose-300/10 p-4 transition duration-200 hover:-translate-y-0.5 hover:border-rose-300/50 hover:bg-rose-300/15 focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-2 focus:ring-offset-[#17131f]">
          <span class="flex items-center gap-3"><span class="text-2xl" aria-hidden="true">📷</span><span><span class="block text-xs text-rose-200/45">02 · {counts.photo} albums</span><strong class="mt-1 block text-white">照片墙</strong></span></span><span class="flex items-center gap-2 text-rose-200/80"><span data-wander-visited-label class="text-[.65rem] font-medium"></span><span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/wander/notes/" data-wander-link data-wander-key="notes" data-wander-shortcut="3" class="wander-link group flex items-center justify-between rounded-2xl border border-amber-300/25 bg-amber-400/10 p-4 transition duration-200 hover:-translate-y-0.5 hover:border-amber-300/60 hover:bg-amber-400/20 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2 focus:ring-offset-[#17131f]">
          <span class="flex items-center gap-3"><span class="text-2xl" aria-hidden="true">✦</span><span><span class="block text-xs text-amber-200/50">03 · {counts.essay} notes</span><strong class="mt-1 block text-white">支线随笔</strong></span></span><span class="flex items-center gap-2 text-amber-300"><span data-wander-visited-label class="text-[.65rem] font-medium"></span><span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
        <a href="/memo/" data-wander-link data-wander-key="memo" data-wander-shortcut="4" class="wander-link group flex items-center justify-between rounded-2xl border border-emerald-300/25 bg-emerald-400/10 p-4 transition duration-200 hover:-translate-y-0.5 hover:border-emerald-300/60 hover:bg-emerald-400/20 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-[#17131f]">
          <span class="flex items-center gap-3"><span class="text-2xl" aria-hidden="true">🪵</span><span><span class="block text-xs text-emerald-200/50">04 · 小木广播</span><strong class="mt-1 block text-white">电台</strong></span></span><span class="flex items-center gap-2 text-emerald-300"><span data-wander-visited-label class="text-[.65rem] font-medium"></span><span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </a>
      </nav>
      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-violet-100/45" data-wander-timeline hidden aria-live="polite">
        <span>最近足迹</span>
        <ol class="flex flex-wrap gap-x-4 gap-y-1" data-wander-timeline-list></ol>
      </div>
      <p class="mt-3 text-xs text-violet-100/45" data-wander-complete aria-live="polite"></p>
      <p class="mt-1 text-xs text-violet-100/35">快捷键只在没有输入文字时生效。进度仅保存在当前浏览器。</p>
    </section>

    <p class="mt-8 text-center text-sm text-violet-100/50">这里允许没有用。<span class="text-violet-100/30">—— 番剧、摄影，和没有 KPI 的念头，都属于同一个人。</span></p>
  </div>
</BaseLayout>

<script>
  import { formatWanderFootprintTime, getWanderDirectoryState, getWanderStorage, getWanderTimeScene, normalizeWanderScene, normalizeWanderScenePreference, readRecentProgress, readVisitedProgress, readStorageValue, shouldInitializeWander, writeStorageValue, writeVisitedProgress } from "../../utils/wander-storage";

  function initSceneSwitch() {
    const room = document.querySelector<HTMLElement>("[data-wander-room]");
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-scene-button]");
    const text = document.querySelector<HTMLElement>("[data-scene-text]");
    if (!room || !buttons.length || !shouldInitializeWander(room.dataset.ready)) return;
    const setScene = (scene: string) => {
      const preference = normalizeWanderScenePreference(scene);
      const normalizedScene = preference === "auto" ? getWanderTimeScene() : normalizeWanderScene(preference);
      room.dataset.scene = normalizedScene;
      if (text) text.textContent = ({ dawn: "清晨，光线很软", day: "午后，风很轻", dusk: "黄昏，光线正好", night: "夜晚，星星亮着" } as Record<string, string>)[normalizedScene];
      buttons.forEach((button) => {
        const active = button.dataset.sceneButton === preference;
        button.classList.toggle("wander-scene-btn-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      const storage = getWanderStorage();
      if (readStorageValue(storage, "muxin-wander-scene") !== preference) writeStorageValue(storage, "muxin-wander-scene", preference);
      window.dispatchEvent(new CustomEvent("muxin-wander-scene", { detail: { scene: normalizedScene, preference } }));
    };
    buttons.forEach((button) => button.addEventListener("click", () => setScene(button.dataset.sceneButton ?? "night")));
    setScene(readStorageValue(getWanderStorage(), "muxin-wander-scene") ?? "auto");
    window.addEventListener("storage", (event) => {
      if (event.key === "muxin-wander-scene") setScene(event.newValue ?? "auto");
    });
    room.dataset.ready = "true";
  }
  initSceneSwitch();
  document.addEventListener("astro:page-load", initSceneSwitch);

  function initWanderDirectory() {
    const directory = document.querySelector<HTMLElement>("[data-wander-directory]");
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-wander-link]")];
    const progress = document.querySelector<HTMLElement>("[data-wander-progress]");
    const roomStatus = document.querySelector<HTMLElement>("[data-room-status]");
    const roomStatusCopy = document.querySelector<HTMLElement>("[data-room-status-copy]");
    const completion = document.querySelector<HTMLElement>("[data-wander-complete]");
    const timeline = document.querySelector<HTMLElement>("[data-wander-timeline]");
    const timelineList = document.querySelector<HTMLOListElement>("[data-wander-timeline-list]");
    if (!directory || !links.length || !shouldInitializeWander(directory.dataset.ready)) return;
    const storageKey = "muxin-wander-visited";
    const recentStorageKey = "muxin-wander-recent";
    const labels: Record<string, string> = { anime: "番剧书架", photo: "照片墙", notes: "支线随笔", memo: "小木电台" };
    const storage = getWanderStorage();
    const readVisited = () => readVisitedProgress(storage, storageKey);
    const updateProgress = () => {
      const visited = readVisited();
      const state = getWanderDirectoryState(visited, readRecentProgress(storage, recentStorageKey), links.map((link) => link.dataset.wanderKey ?? ""));
      links.forEach((link) => {
        const isVisited = state.visitedKeys.has(link.dataset.wanderKey ?? "");
        link.dataset.visited = isVisited ? "true" : "false";
        const label = link.querySelector<HTMLElement>("[data-wander-visited-label]");
        if (label) label.textContent = isVisited ? "已到访" : "";
      });
      if (progress) progress.textContent = `${state.explored} / ${state.total}`;
      directory.dataset.complete = state.isComplete ? "true" : "false";
      if (roomStatus) roomStatus.textContent = state.isComplete ? "房间已点亮" : "开放参观";
      if (roomStatusCopy) roomStatusCopy.textContent = state.isComplete ? "四条支线都留下过脚印" : "从一个入口开始逛";
      if (completion) completion.textContent = state.isComplete ? "四个入口都到访过了。现在回到上面，看看房间亮起来的样子。" : "";
      if (timeline && timelineList) {
        const recent = state.recent.filter((item) => labels[item.key]);
        timeline.hidden = recent.length === 0;
        timelineList.replaceChildren(...recent.map((item, index) => {
          const listItem = document.createElement("li");
          listItem.className = "flex items-center gap-2";
          const dot = document.createElement("span");
          dot.className = `h-1.5 w-1.5 shrink-0 rounded-full ${index === 0 ? "bg-violet-300" : "bg-violet-300/40"}`;
          const label = document.createElement("span");
          label.textContent = labels[item.key];
          const time = document.createElement("time");
          time.className = "text-violet-100/35";
          time.dateTime = new Date(item.visitedAt).toISOString();
          time.textContent = formatWanderFootprintTime(item.visitedAt);
          listItem.append(dot, label, time);
          return listItem;
        }));
      }
    };
    links.forEach((link) => link.addEventListener("click", () => {
      const visited = readVisited();
      const key = link.dataset.wanderKey;
      if (key) visited.add(key);
      writeVisitedProgress(storage, storageKey, visited);
      updateProgress();
    }));
    window.addEventListener("muxin-wander-progress", updateProgress);
    window.addEventListener("storage", updateProgress);
    directory.addEventListener("keydown", (event) => {
      if (!(event instanceof KeyboardEvent) || event.metaKey || event.ctrlKey || event.altKey) return;
      const link = links.find((item) => item.dataset.wanderShortcut === event.key);
      if (link && document.activeElement?.tagName !== "INPUT" && document.activeElement?.tagName !== "TEXTAREA") {
        event.preventDefault();
        link.focus();
      }
    });
    updateProgress();
    directory.dataset.ready = "true";
  }
  initWanderDirectory();
  document.addEventListener("astro:page-load", initWanderDirectory);
</script>

<style>
  .wander-deferred-section { content-visibility: auto; contain-intrinsic-size: 0 560px; }
  .wander-room-ui { --wander-glow: rgba(139, 92, 246, .14); }
  .wander-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin-top: 1rem; border: 1px solid rgba(139, 92, 246, .22); border-radius: 1rem; background: rgba(23, 19, 31, .55); padding: .6rem .9rem; backdrop-filter: blur(8px); }
  .wander-scene-switch { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
  .wander-scene-switch-label { margin-right: .35rem; color: rgba(196, 181, 253, .6); font-size: .68rem; letter-spacing: .08em; }
  .wander-scene-btn { border: 1px solid rgba(139, 92, 246, .25); border-radius: .6rem; background: transparent; padding: .35rem .7rem; color: rgba(196, 181, 253, .65); font-size: .72rem; transition: background .18s, color .18s, border-color .18s; }
  .wander-scene-btn:hover { border-color: rgba(255, 209, 102, .5); color: #fff7ed; }
  .wander-scene-btn-active { border-color: #d59b37; background: rgba(213, 155, 55, .22); color: #ffe29a; }
  .wander-toolbar-note { color: rgba(216, 207, 234, .6); font-size: .72rem; }
  .wander-room-status { color: #7ee2a8; }
  .wander-link[data-visited="true"] { border-color: rgba(213, 155, 55, .55); background: rgba(213, 155, 55, .12); }
  .wander-link[data-visited="true"] strong { color: #ffe29a; }
  .wander-link[data-visited="true"] [data-wander-visited-label] { color: #ffd166; }
  [data-wander-directory][data-complete="true"] { border-color: rgba(167, 139, 250, .5); box-shadow: 0 1.5rem 4rem rgba(124, 58, 237, .12); }
  [data-wander-directory][data-complete="true"] [data-wander-complete] { color: #c4b5fd; }
  @media (max-width: 639px) {
    .wander-toolbar { justify-content: center; }
    .wander-toolbar-note { text-align: center; }
  }
</style>
