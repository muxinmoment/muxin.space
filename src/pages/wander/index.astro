---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("wander", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const counts = {
  anime: entries.filter((entry) => entry.data.type === "anime").length,
  photo: entries.filter((entry) => entry.data.type === "photo").length,
  essay: entries.filter((entry) => entry.data.type === "essay").length,
};
---

<BaseLayout title="漫游 | muxin.space" description="番剧、摄影和不太正经的个人支线。">
  <div class="mx-auto max-w-6xl" data-wander-room data-scene="night">
    <section class="relative overflow-hidden rounded-[2rem] border border-violet-300/30 bg-[#17131f] p-6 text-white shadow-2xl shadow-violet-950/10 transition-colors duration-500 sm:p-10">
      <div class="pointer-events-none absolute inset-0 opacity-60 [background-image:radial-gradient(circle_at_20%_20%,rgba(167,139,250,.2)_0,transparent_25%),radial-gradient(circle_at_80%_10%,rgba(244,114,182,.14)_0,transparent_22%),radial-gradient(circle_at_70%_90%,rgba(251,191,36,.12)_0,transparent_25%)]"></div>
      <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <div class="flex items-center gap-3"><span class="h-2 w-2 animate-pulse rounded-full bg-violet-400"></span><p class="eyebrow text-violet-300">Wander room · personal space</p></div>
          <h1 class="mt-5 max-w-3xl font-serif text-5xl leading-[1.04] tracking-tight sm:text-7xl">欢迎来到我的<br /><span class="text-violet-300">私人支线。</span></h1>
          <p class="mt-5 max-w-xl text-sm leading-8 text-violet-100/70">这里不负责证明我会什么，只负责留下我喜欢什么。番剧、摄影、游戏和一些没有 KPI 的念头，都可以在这里找到位置。</p>
        </div>
        <div class="flex shrink-0 items-center gap-2 rounded-full border border-white/15 bg-white/5 p-1 text-xs">
          <button type="button" data-scene-button="night" class="rounded-full bg-violet-500 px-3 py-1.5 font-medium text-white">夜航</button>
          <button type="button" data-scene-button="day" class="rounded-full px-3 py-1.5 text-violet-200/60 transition hover:text-white">晴空</button>
        </div>
      </div>

      <div class="relative mt-10 grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="min-h-[250px] rounded-3xl border border-white/10 bg-white/[0.06] p-5 sm:p-7">
          <div class="flex items-center justify-between"><p class="text-xs font-semibold uppercase tracking-[0.18em] text-violet-300">Room status</p><span class="text-xs text-violet-100/50">currently online</span></div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            <div><p class="text-xs text-violet-100/50">窗外天气</p><p data-scene-text class="mt-2 font-serif text-3xl">深夜，有星星</p></div>
            <div><p class="text-xs text-violet-100/50">桌面上</p><p class="mt-2 font-serif text-3xl">一台相机</p></div>
          </div>
          <div class="mt-10 flex items-center gap-2 text-xs text-violet-100/60"><span class="rounded-full bg-emerald-400/20 px-2.5 py-1 text-emerald-300">开放参观</span><span>从一个入口开始逛</span></div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <a href="/wander/anime/" class="group flex min-h-[116px] flex-col justify-between rounded-3xl border border-violet-300/20 bg-violet-400/10 p-5 transition duration-300 hover:-translate-y-1 hover:bg-violet-400/20"><span class="text-3xl">📺</span><span><span class="block text-xs text-violet-200/50">{counts.anime} records</span><strong class="mt-1 block font-serif text-xl text-white group-hover:text-violet-200">番剧书架</strong></span></a>
          <a href="/wander/photos/" class="group flex min-h-[116px] flex-col justify-between rounded-3xl border border-rose-300/20 bg-rose-400/10 p-5 transition duration-300 hover:-translate-y-1 hover:bg-rose-400/20"><span class="text-3xl">📷</span><span><span class="block text-xs text-rose-100/50">{counts.photo} albums</span><strong class="mt-1 block font-serif text-xl text-white group-hover:text-rose-200">照片墙</strong></span></a>
          <a href="/wander/notes/" class="group flex min-h-[116px] flex-col justify-between rounded-3xl border border-amber-300/20 bg-amber-400/10 p-5 transition duration-300 hover:-translate-y-1 hover:bg-amber-400/20"><span class="text-3xl">✦</span><span><span class="block text-xs text-amber-100/50">{counts.essay} notes</span><strong class="mt-1 block font-serif text-xl text-white group-hover:text-amber-200">支线随笔</strong></span></a>
          <a href="/memo/" class="group flex min-h-[116px] flex-col justify-between rounded-3xl border border-emerald-300/20 bg-emerald-400/10 p-5 transition duration-300 hover:-translate-y-1 hover:bg-emerald-400/20"><span class="text-3xl">🪵</span><span><span class="block text-xs text-emerald-100/50">小木广播</span><strong class="mt-1 block font-serif text-xl text-white group-hover:text-emerald-200">电台</strong></span></a>
        </div>
      </div>
    </section>

    <section class="mt-8 grid gap-4 lg:grid-cols-[0.8fr_1.2fr]">
      <article class="rounded-3xl border border-zinc-200 bg-white p-6 sm:p-8">
        <p class="eyebrow">Room rule 001</p>
        <h2 class="mt-3 font-serif text-3xl leading-tight text-zinc-900">这里允许没有用。</h2>
        <p class="mt-4 text-sm leading-8 text-zinc-500">技术文章要解决问题，漫游内容只需要诚实地留下感受。两套内容不混在一起，但它们都属于同一个人。</p>
      </article>
      <article class="rounded-3xl border border-zinc-200 bg-zinc-50 p-6 sm:p-8">
        <p class="eyebrow">Coming soon</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-zinc-200 bg-white p-4"><p class="text-2xl">🎞️</p><p class="mt-3 font-medium text-zinc-900">本季在看</p><p class="mt-1 text-xs leading-6 text-zinc-500">等第一份番剧记录</p></div>
          <div class="rounded-2xl border border-zinc-200 bg-white p-4"><p class="text-2xl">🖼️</p><p class="mt-3 font-medium text-zinc-900">摄影档案</p><p class="mt-1 text-xs leading-6 text-zinc-500">等下一组照片</p></div>
          <div class="rounded-2xl border border-zinc-200 bg-white p-4"><p class="text-2xl">🎧</p><p class="mt-3 font-medium text-zinc-900">深夜电台</p><p class="mt-1 text-xs leading-6 text-zinc-500">等一段想说的话</p></div>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>

<script>
  function initSceneSwitch() {
    const room = document.querySelector<HTMLElement>("[data-wander-room]");
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-scene-button]");
    const text = document.querySelector<HTMLElement>("[data-scene-text]");
    if (!room || !buttons.length || room.dataset.ready === "true") return;
    const setScene = (scene: string) => {
      room.dataset.scene = scene;
      if (text) text.textContent = scene === "day" ? "晴天，风很轻" : "深夜，有星星";
      buttons.forEach((button) => {
        const active = button.dataset.sceneButton === scene;
        button.classList.toggle("bg-violet-500", active && scene === "night");
        button.classList.toggle("bg-amber-400", active && scene === "day");
        button.classList.toggle("text-white", active);
        button.classList.toggle("text-violet-200/60", !active);
      });
      localStorage.setItem("muxin-wander-scene", scene);
    };
    buttons.forEach((button) => button.addEventListener("click", () => setScene(button.dataset.sceneButton ?? "night")));
    setScene(localStorage.getItem("muxin-wander-scene") ?? "night");
    room.dataset.ready = "true";
  }
  initSceneSwitch();
  document.addEventListener("astro:page-load", initSceneSwitch);
</script>

<style>
  [data-wander-room][data-scene="day"] > section:first-child { background: linear-gradient(135deg, #713f12 0%, #1f2937 70%); }
  [data-wander-room][data-scene="day"] [data-scene-button="night"] { background: transparent; color: rgba(224, 231, 255, .6); }
  [data-wander-room][data-scene="day"] [data-scene-button="day"] { background: #f59e0b; color: white; }
</style>
