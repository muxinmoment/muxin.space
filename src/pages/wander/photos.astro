---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = (await getCollection("wander", ({ data }) => !data.draft && data.type === "photo")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="照片墙 | 漫游" description="把照片挂回它们应该在的墙上。">
  <div class="mx-auto max-w-5xl">
    <a href="/wander/" class="text-sm text-zinc-500 hover:text-rose-600">← 回到漫游</a>
    <header class="mt-10 flex flex-col gap-4 border-b border-rose-200 pb-10 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow text-rose-500">Photo wall</p><h1 class="mt-3 font-serif text-5xl tracking-tight text-zinc-900">照片墙</h1><p class="mt-4 max-w-2xl text-base leading-8 text-zinc-500">不是图库，是一面挂着时间的墙。照片、现场和按下快门时没有说出口的东西。</p></div><span class="tag-accent">{entries.length} 张记录</span></header>
    <section class="photo-wall mt-10">
      {entries.length ? entries.map((entry, index) => <a href={`/wander/${entry.id}/`} class={`photo-frame photo-frame-${index % 5}`}><div class="photo-image">{entry.data.cover ? <img src={entry.data.cover} alt={entry.data.title} loading="lazy" /> : <span>待挂入真实照片</span>}</div><div class="photo-caption"><h2>{entry.data.title}</h2><p>{entry.data.description}</p></div></a>) : Array.from({ length: 5 }, (_, index) => <div class={`photo-frame empty-photo photo-frame-${index}`}><div class="photo-image"><span>{["第一张照片", "光线会从这里进来", "留一个空相框", "等待下一次按快门", "这里暂时没有故事"][index]}</span></div><div class="photo-caption"><p>真实摄影素材待补</p></div></div>)}
    </section>
    {!entries.length && <div class="mt-8 rounded-3xl border border-dashed border-rose-300 bg-rose-50/60 p-8 text-center"><p class="text-3xl">📷</p><p class="mt-3 font-serif text-2xl text-zinc-900">墙已经留好了位置</p><p class="mt-2 text-sm leading-7 text-zinc-500">我不会用库存图冒充你的摄影作品。等真实照片放进来，它们会自动变成墙上的画。</p></div>}
  </div>
</BaseLayout>

<style>
  .photo-wall { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1.2rem; align-items: start; }
  .photo-frame { grid-column: span 4; padding: .7rem .7rem 1rem; background: #fff; box-shadow: 0 16px 30px rgba(136,19,55,.09); transition: transform .3s, box-shadow .3s; }
  .photo-frame:hover { z-index: 1; transform: translateY(-6px) rotate(0deg) scale(1.02); box-shadow: 0 24px 44px rgba(136,19,55,.16); }
  .photo-frame-1 { transform: rotate(2deg); grid-column: span 5; margin-top: 1.5rem; }
  .photo-frame-2 { transform: rotate(-1.5deg); grid-column: span 3; }
  .photo-frame-3 { transform: rotate(1deg); grid-column: span 5; }
  .photo-frame-4 { transform: rotate(-2deg); grid-column: span 4; margin-top: 1.2rem; }
  .photo-image { display: grid; min-height: 180px; place-items: center; overflow: hidden; background: linear-gradient(145deg, #ffe4e6, #f5d0fe); color: #9f1239; font-family: var(--font-serif); font-size: .9rem; text-align: center; }
  .photo-image img { width: 100%; height: 100%; min-height: 180px; object-fit: cover; }
  .photo-caption { padding: .8rem .3rem .1rem; }
  .photo-caption h2 { font-family: var(--font-serif); font-size: 1.05rem; color: #18181b; }
  .photo-caption p { margin-top: .3rem; color: #71717a; font-size: .72rem; line-height: 1.6; }
  .empty-photo { opacity: .82; }
  @media (max-width: 640px) { .photo-frame, .photo-frame-1, .photo-frame-2, .photo-frame-3, .photo-frame-4 { grid-column: span 6; } .photo-frame-2 { margin-top: 1rem; } }
</style>
