---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = (await getCollection("wander", ({ data }) => !data.draft && data.type === "photo")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<BaseLayout title="取景框之外 | 漫游" description="摄影作品与拍摄记录。">
  <div class="mx-auto max-w-5xl"><a href="/wander/" class="text-sm text-zinc-500 hover:text-rose-600">← 回到漫游</a><header class="mt-10 flex flex-col gap-4 border-b border-rose-200 pb-10 sm:flex-row sm:items-end sm:justify-between"><div><p class="eyebrow text-rose-500">Photo archive</p><h1 class="mt-3 font-serif text-5xl tracking-tight text-zinc-900">取景框之外</h1><p class="mt-4 max-w-2xl text-base leading-8 text-zinc-500">光线、角色、场景，以及按下快门后留下来的那一点感觉。</p></div><span class="tag-accent">{entries.length} 组记录</span></header><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{entries.length ? entries.map((entry) => <a href={`/wander/${entry.id}/`} class="group overflow-hidden rounded-2xl border border-zinc-200 bg-white hover:border-rose-300"><div class="aspect-[4/3] bg-rose-50"></div><div class="p-4"><h2 class="font-serif text-lg text-zinc-900 group-hover:text-rose-600">{entry.data.title}</h2><p class="mt-1 text-sm text-zinc-500">{entry.data.description}</p></div></a>) : <div class="rounded-2xl border border-dashed border-rose-300 bg-rose-50/50 p-12 text-center sm:col-span-2 lg:col-span-3"><p class="text-3xl">📷</p><p class="mt-3 font-serif text-xl text-zinc-900">相册还在等第一张照片</p><p class="mt-2 text-sm text-zinc-500">这里会优先使用真实摄影素材，不用占位图冒充作品。</p></div>}</div></div>
</BaseLayout>
