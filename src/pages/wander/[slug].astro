---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("wander", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const branch = entry.data.type === "anime" ? { key: "anime", label: "番剧书架", href: "/wander/anime/" } : entry.data.type === "photo" ? { key: "photo", label: "照片墙", href: "/wander/photos/" } : { key: "notes", label: "支线随笔", href: "/wander/notes/" };
---
<BaseLayout title={`${entry.data.title} | 漫游`} description={entry.data.description} type="article">
  <article class="mx-auto max-w-3xl" data-wander-detail data-wander-key={branch.key} data-wander-label={branch.label}>
    <div class="flex flex-wrap items-center justify-between gap-3"><a href="/wander/" class="text-sm text-zinc-500 hover:text-violet-600 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2">← 回到漫游</a><span data-wander-detail-footprint class="text-xs text-zinc-400" aria-live="polite"></span></div>
    <header class="mt-10 border-b border-zinc-200 pb-10"><p class="eyebrow">{entry.data.type} · {entry.data.pubDate.toISOString().slice(0, 10)}</p><h1 class="mt-4 font-serif text-5xl leading-tight tracking-tight text-zinc-900">{entry.data.title}</h1><p class="mt-5 text-lg leading-8 text-zinc-500">{entry.data.description}</p></header>
    <div class="article-prose prose prose-zinc mt-10 max-w-none"><Content /></div>
    <nav class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200 pt-6" aria-label="漫游继续探索"><a href={branch.href} class="rounded-full border border-zinc-200 px-4 py-2 text-sm text-zinc-600 transition hover:border-violet-300 hover:text-violet-600 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2">继续探索{branch.label} →</a><a href="/wander/" class="text-sm text-zinc-400 transition hover:text-violet-600 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2">回到漫游入口</a></nav>
  </article>
</BaseLayout>

<script>
  import { getWanderStorage, readVisitedProgress, recordRecentProgress, writeVisitedProgress } from "../../utils/wander-storage";

  function initWanderDetail() {
    const detail = document.querySelector<HTMLElement>("[data-wander-detail]");
    const footprint = detail?.querySelector<HTMLElement>("[data-wander-detail-footprint]");
    if (!detail || !footprint || detail.dataset.ready === "true") return;
    const visitedKey = "muxin-wander-visited";
    const recentKey = "muxin-wander-recent";
    const key = detail.dataset.wanderKey;
    if (!key) return;
    const formatFootprintTime = (visitedAt: number) => {
      const visitedDate = new Date(visitedAt);
      const now = new Date();
      if (now.getTime() - visitedDate.getTime() < 60 * 60 * 1000) return "刚刚";
      if (visitedDate.toDateString() === now.toDateString()) return "今天";
      return new Intl.DateTimeFormat("zh-CN", { month: "numeric", day: "numeric" }).format(visitedDate).replace("/", "月") + "日";
    };
    try {
      const storage = getWanderStorage();
      const visited = readVisitedProgress(storage, visitedKey);
      visited.add(key);
      writeVisitedProgress(storage, visitedKey, visited);
      const recent = recordRecentProgress(storage, recentKey, key);
      window.dispatchEvent(new CustomEvent("muxin-wander-progress"));
      footprint.textContent = `当前足迹 · ${detail.dataset.wanderLabel} · ${formatFootprintTime(recent[0].visitedAt)}`;
    } catch {
      footprint.textContent = "继续探索 · 进度仅保存在当前浏览器";
    }
    detail.dataset.ready = "true";
  }
  initWanderDetail();
  document.addEventListener("astro:page-load", initWanderDetail);
</script>
