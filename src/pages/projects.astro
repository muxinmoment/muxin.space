---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const stackCount = new Set(projects.flatMap((project) => project.stack)).size;
const mainProject = projects[0];
const siteProject = projects.find((project) => project.name === "muxin.space");
const featuredBuildNote =
  notes.find((note) => note.id === "from-handwritten-notes-to-an-astro-site") ?? notes[0];
const latestNotes = notes.slice(0, 3);

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
---

<BaseLayout title="Projects | muxin.space" description="正在推进、复盘和公开分享中的个人项目。">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <p class="eyebrow">Projects</p>
        <h1 class="mt-2 font-serif text-3xl leading-tight tracking-tight text-zinc-900">
          这里主要放我正在长期推进的项目主线。
        </h1>
        <p class="mt-3 text-sm leading-7 text-zinc-500">
          项目页负责给你一个全局视角：我在做什么、重点卡在哪里、哪部分已经被拆成文章可以继续看。
        </p>

        <div class="mt-6 flex items-center gap-5">
          <div>
            <p class="font-serif text-xl text-zinc-900">{projects.length}</p>
            <p class="eyebrow mt-0.5">Projects</p>
          </div>
          <div>
            <p class="font-serif text-xl text-zinc-900">{stackCount}</p>
            <p class="eyebrow mt-0.5">Stacks</p>
          </div>
          <div>
            <p class="font-serif text-xl text-zinc-900">{notes.length}</p>
            <p class="eyebrow mt-0.5">Notes</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="/notes/"
            class="inline-flex items-center rounded-full bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700"
          >
            读项目相关文章
            <span class="ml-2">→</span>
          </a>
          <a
            href={`#project-${slugify(mainProject.name)}`}
            class="inline-flex items-center rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-500"
          >
            先看主线项目
          </a>
        </div>
      </div>

      <div class="mt-5 rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <p class="eyebrow">怎么用这个页面</p>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-zinc-600">
          <li class="flex gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
            <span>如果你想最快了解我的技术主线，先看 <strong class="font-medium text-zinc-900">{mainProject.name}</strong>。</span>
          </li>
          <li class="flex gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
            <span>如果你更关心这个网站怎么搭、怎么部署，再看 <strong class="font-medium text-zinc-900">muxin.space</strong> 相关记录。</span>
          </li>
          <li class="flex gap-2.5">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
            <span>项目页看全局，具体实现和踩坑会继续沉淀到文章里，后面直接点进去就行。</span>
          </li>
        </ul>
      </div>
    </aside>

    <div class="min-w-0 space-y-12 lg:col-span-8">
      <section>
        <p class="eyebrow">持续推进中的项目主轴</p>
        <h2 class="mt-3 max-w-[16ch] font-serif text-4xl leading-[1.1] tracking-tight text-zinc-900 sm:text-5xl">
          我更想把项目做成可持续复盘的公开资产。
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-zinc-500">
          所以这里不会只放结果图。更重要的是把项目的定位、技术点和后续文章入口整理清楚，让它们真的能被别人读懂和继续追踪。
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <p class="text-sm font-medium text-zinc-900">当前主线</p>
            <p class="mt-2 font-serif text-lg tracking-tight text-zinc-900">{mainProject.name}</p>
            <p class="mt-1.5 text-sm leading-7 text-zinc-500">{mainProject.summary}</p>
            <a
              href={`#project-${slugify(mainProject.name)}`}
              class="mt-3 inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900"
            >
              跳到这个项目
              <span class="ml-2">→</span>
            </a>
          </article>
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <p class="text-sm font-medium text-zinc-900">推荐起点</p>
            <p class="mt-2 font-serif text-lg tracking-tight text-zinc-900">
              {featuredBuildNote.data.title}
            </p>
            <p class="mt-1.5 text-sm leading-7 text-zinc-500">
              {featuredBuildNote.data.description}
            </p>
            <a
              href={`/notes/${featuredBuildNote.id}/`}
              class="mt-3 inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900"
            >
              先读这篇
              <span class="ml-2">→</span>
            </a>
          </article>
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <p class="text-sm font-medium text-zinc-900">内容入口</p>
            <p class="mt-2 text-sm leading-7 text-zinc-500">项目页负责全局概览，文章页负责拆细节。</p>
            <div class="mt-3 flex flex-col gap-1.5">
              <a href="/notes/" class="inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900">
                看全部分享 →
              </a>
              <a href="/about/" class="inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900">
                看我的背景 →
              </a>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">项目列表</p>
            <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">主线项目先铺开，再慢慢把细节补厚</h2>
          </div>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <div id={`project-${slugify(project.name)}`}>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="eyebrow">项目之外</p>
              <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">已经写出来的相关内容</h2>
            </div>
            <a
              href="/notes/"
              class="text-sm font-medium text-zinc-500 transition hover:text-zinc-900"
            >
              查看全部 →
            </a>
          </div>

          <div class="mt-5 space-y-3">
            {latestNotes.map((note) => (
              <a
                href={`/notes/${note.id}/`}
                class="block rounded-xl border border-zinc-100 bg-zinc-50 p-4 transition duration-200 hover:border-zinc-300 hover:bg-white"
              >
                <p class="eyebrow">
                  {note.data.pubDate.toISOString().slice(0, 10)}
                </p>
                <h3 class="mt-2 font-serif text-lg tracking-tight text-zinc-900">
                  {note.data.title}
                </h3>
                <p class="mt-1.5 text-sm leading-7 text-zinc-500">{note.data.description}</p>
              </a>
            ))}
          </div>
        </article>

        <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
          {siteProject && (
            <div>
              <p class="eyebrow">这个站本身也是项目</p>
              <p class="mt-3 text-sm leading-7 text-zinc-600">{siteProject.summary}</p>
              <a
                href={`#project-${slugify(siteProject.name)}`}
                class="mt-4 inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900"
              >
                回到这个项目
                <span class="ml-2">→</span>
              </a>
            </div>
          )}
        </article>
      </section>
    </div>
  </div>
</BaseLayout>
