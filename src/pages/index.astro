---
import { getCollection } from "astro:content";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { noteCategoryMeta } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  currentFocus,
  profile,
  projects,
} from "../data";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const [featuredNote, ...recentNotes] = notes;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  title="muxin.space | 知识分享与项目公开记录"
  description="分享 AI 工程、全栈实践、项目复盘和带点个人风格的长期内容。"
>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <div class="mt-6">
          <ProfileAvatar
            src={profile.avatar}
            alt={`${profile.name} 的头像`}
            sizeClass="h-20 w-20"
            badge="学习中"
            showBadge={true}
          />
        </div>

        <div class="mt-5">
          <p class="eyebrow">Identity</p>
          <h1 class="mt-2 font-serif text-4xl tracking-tight text-zinc-900">
            {profile.name}
          </h1>
          <p class="mt-3 text-sm leading-7 text-zinc-500">
            {profile.description}
          </p>
        </div>

        <div class="mt-6 flex items-center gap-6">
          <div>
            <p class="font-serif text-2xl text-zinc-900">{notes.length}</p>
            <p class="eyebrow mt-0.5">Sharing</p>
          </div>
          <div>
            <p class="font-serif text-2xl text-zinc-900">{projects.length}</p>
            <p class="eyebrow mt-0.5">Projects</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="/notes/"
            class="inline-flex items-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700"
          >
            阅读分享
            <span class="ml-2">→</span>
          </a>
          <a
            href="/about/"
            class="inline-flex items-center rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-500"
          >
            关于我
          </a>
        </div>
      </div>
    </aside>

    <div class="min-w-0 space-y-12 lg:col-span-8">
      <section>
        <p class="eyebrow">AI 应用开发 · Agent 工程 · 技术写作</p>
        <h2 class="mt-3 max-w-3xl font-serif text-5xl leading-[1.05] tracking-tight text-zinc-900 sm:text-6xl">
          把 AI 做成<br /><span class="text-rose-600">真正能用的系统。</span>
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-zinc-500">
          我是 Muxin，一名偏工程落地的 AI 专业学生。这里记录我如何设计 Agent、搭建 RAG、验证模型，也记录那些让项目变得更可靠的取舍。
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href="/portfolio/" class="inline-flex items-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700">
            看作品集 <span class="ml-2">→</span>
          </a>
          <a href="/resume/" class="inline-flex items-center rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-500">
            看经历
          </a>
        </div>

        <div class="mt-8 rounded-2xl border border-zinc-200 bg-zinc-50 p-1.5" data-mode-switch>
          <div class="grid grid-cols-2 gap-1.5">
            <button type="button" data-mode-button="career" class="rounded-xl bg-white px-3 py-2.5 text-sm font-medium text-zinc-900 shadow-sm transition">求职模式</button>
            <button type="button" data-mode-button="wander" class="rounded-xl px-3 py-2.5 text-sm font-medium text-zinc-500 transition hover:text-zinc-900">漫游模式</button>
          </div>
        </div>
      </section>

      <section data-mode-panel="career" class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <div class="flex items-center justify-between gap-4">
          <p class="eyebrow">Recruiter view</p>
          <span class="tag-accent">快速了解我</span>
        </div>
        <p class="mt-4 max-w-2xl text-base leading-8 text-zinc-600">
          先看实习工程闭环，再看 Agent / RAG / 模型工程三个项目。每个案例都给出我的角色、关键取舍和可验证结果。
        </p>
        <div class="mt-5 flex flex-wrap gap-2 text-sm">
          <a href="/portfolio/internship/" class="rounded-full bg-zinc-900 px-4 py-2 font-medium text-white hover:bg-zinc-700">实习案例 →</a>
          <a href="/portfolio/" class="rounded-full border border-zinc-300 px-4 py-2 font-medium text-zinc-700 hover:border-zinc-500">项目作品集 →</a>
        </div>
      </section>

      <section data-mode-panel="wander" class="hidden rounded-2xl border border-violet-200 bg-[linear-gradient(135deg,#faf5ff_0%,#fff1f2_100%)] p-6 sm:p-7">
        <div class="flex items-center justify-between gap-4">
          <p class="eyebrow text-violet-500">Wander mode · side quests</p>
          <span class="tag">Lv. 21 · 持续升级</span>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-white/80 bg-white/70 p-4"><p class="text-xs text-zinc-400">主线任务</p><p class="mt-2 font-serif text-lg text-zinc-900">把 AI 做成产品</p></div>
          <div class="rounded-xl border border-white/80 bg-white/70 p-4"><p class="text-xs text-zinc-400">支线任务</p><p class="mt-2 font-serif text-lg text-zinc-900">拍好下一组片</p></div>
          <div class="rounded-xl border border-white/80 bg-white/70 p-4"><p class="text-xs text-zinc-400">被动技能</p><p class="mt-2 font-serif text-lg text-zinc-900">看番 + 拆系统</p></div>
        </div>
        <p class="mt-5 text-sm leading-7 text-zinc-600">技术是主线，二次元和摄影是让这条主线不变得无聊的支线。</p>
      </section>

      <section class="grid gap-6 lg:grid-cols-12">
        {featuredNote && (
          <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-8 lg:col-span-8">
            <div class="flex items-center justify-between gap-4">
              <p class="eyebrow">最新分享</p>
              <time class="text-xs text-zinc-400" datetime={featuredNote.data.pubDate.toISOString()}>
                {dateFormatter.format(featuredNote.data.pubDate)}
              </time>
            </div>

            <a href={`/notes/${featuredNote.id}/`} class="group mt-4 block">
              <h2 class="max-w-3xl font-serif text-xl sm:text-2xl leading-tight tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600">
                {featuredNote.data.title}
              </h2>
              <p class="mt-3 max-w-3xl text-sm leading-7 text-zinc-500">
                {featuredNote.data.description}
              </p>
            </a>

            <div class="mt-5 flex flex-wrap items-center gap-1.5">
              <a href={`/notes/category/${noteCategoryMeta[featuredNote.data.category].slug}/`} class="tag-accent">
                {featuredNote.data.category}
              </a>
              {featuredNote.data.tags.slice(0, 2).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <a
              href={`/notes/${featuredNote.id}/`}
              class="mt-6 inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900"
            >
              继续阅读
              <span class="ml-2">→</span>
            </a>
          </article>
        )}

        <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7 lg:col-span-4">
          <p class="eyebrow">当前关注点</p>
          <ul class="mt-4 space-y-3">
            {currentFocus.map((item) => (
              <li class="flex items-start justify-between gap-3 text-sm leading-7 text-zinc-600">
                <span class="flex gap-2.5">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
                  <span>{item.text}</span>
                </span>
                <span class="tag shrink-0">{item.status}</span>
              </li>
            ))}
          </ul>
        </article>
      </section>

      <section class="rounded-2xl border border-zinc-200 bg-zinc-900 p-6 text-white sm:p-7">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="eyebrow text-zinc-500">Featured experience</p>
            <h2 class="mt-2 font-serif text-2xl tracking-tight">当前最重要的一段实践</h2>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-zinc-300">
              在 AI 测试平台实习中，把“生成用例”推进成“生成—真机执行—反馈校准”的完整工程闭环。
            </p>
          </div>
          <a href="/portfolio/internship/" class="shrink-0 text-sm font-medium text-white transition hover:text-rose-300">
            查看案例 →
          </a>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-zinc-700 bg-zinc-800/70 p-4"><p class="text-xs text-zinc-400">真机一次通过率</p><p class="mt-2 font-serif text-2xl">72.7% → 90.5%</p></div>
          <div class="rounded-xl border border-zinc-700 bg-zinc-800/70 p-4"><p class="text-xs text-zinc-400">用例有效率</p><p class="mt-2 font-serif text-2xl">34.9% → 78.6%</p></div>
          <div class="rounded-xl border border-zinc-700 bg-zinc-800/70 p-4"><p class="text-xs text-zinc-400">工程方法</p><p class="mt-2 font-serif text-2xl">闭环校准</p></div>
        </div>
      </section>

      {recentNotes.length > 0 && (
        <section class="grid gap-4 sm:grid-cols-2">
          {recentNotes.map((note) => (
            <article class="rounded-2xl border border-zinc-200 bg-white p-5 transition duration-200 hover:border-zinc-400">
              <div class="flex items-center justify-between gap-3">
                <a
                  href={`/notes/category/${noteCategoryMeta[note.data.category].slug}/`}
                  class="tag-accent"
                >
                  {note.data.category}
                </a>
                <time class="text-xs text-zinc-400" datetime={note.data.pubDate.toISOString()}>
                  {dateFormatter.format(note.data.pubDate)}
                </time>
              </div>

              <a href={`/notes/${note.id}/`} class="group mt-4 block">
                <h2 class="font-serif text-xl tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600">
                  {note.data.title}
                </h2>
                <p class="mt-2 text-sm leading-7 text-zinc-500">
                  {note.data.description}
                </p>
              </a>
            </article>
          ))}
        </section>
      )}

      <section>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">公开项目</p>
            <h2 class="mt-2 font-serif text-3xl tracking-tight text-zinc-900">
              不是只放结果，而是把过程也拆出来
            </h2>
          </div>
          <a
            href="/portfolio/"
            class="text-sm font-medium text-zinc-500 transition hover:text-zinc-900"
          >
            查看作品集 →
          </a>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  function initModeSwitch() {
    const root = document.querySelector<HTMLElement>('[data-mode-switch]');
    if (!root || root.dataset.ready === "true") return;
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-mode-button]");
    const panels = document.querySelectorAll<HTMLElement>("[data-mode-panel]");
    const setMode = (mode: string) => {
      buttons.forEach((button) => {
        const active = button.dataset.modeButton === mode;
        button.classList.toggle("bg-white", active);
        button.classList.toggle("text-zinc-900", active);
        button.classList.toggle("shadow-sm", active);
        button.classList.toggle("text-zinc-500", !active);
      });
      panels.forEach((panel) => panel.classList.toggle("hidden", panel.dataset.modePanel !== mode));
      document.documentElement.dataset.siteMode = mode;
      localStorage.setItem("muxin-site-mode", mode);
      localStorage.setItem("muxin-home-mode", mode);
    };
    buttons.forEach((button) => button.addEventListener("click", () => setMode(button.dataset.modeButton ?? "career")));
    setMode(localStorage.getItem("muxin-site-mode") ?? localStorage.getItem("muxin-home-mode") ?? "career");
    root.dataset.ready = "true";
  }

  initModeSwitch();
  document.addEventListener("astro:page-load", initModeSwitch);
</script>
