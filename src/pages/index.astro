---
import { getCollection } from "astro:content";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { noteCategoryMeta } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  currentFocus,
  profile,
  projects,
} from "../data";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const [featuredNote, ...recentNotes] = notes;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout
  title="muxin.space | 知识分享与项目公开记录"
  description="分享 AI 工程、全栈实践、项目复盘和带点个人风格的长期内容。"
>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <div class="mt-6">
          <ProfileAvatar
            src={profile.avatar}
            alt={`${profile.name} 的头像`}
            sizeClass="h-20 w-20"
            badge="学习中"
            showBadge={true}
          />
        </div>

        <div class="mt-5">
          <p class="eyebrow">Identity</p>
          <h1 class="mt-2 font-serif text-4xl tracking-tight text-zinc-900">
            {profile.name}
          </h1>
          <p class="mt-3 text-sm leading-7 text-zinc-500">
            {profile.description}
          </p>
        </div>

        <div class="mt-6 flex items-center gap-6">
          <div>
            <p class="font-serif text-2xl text-zinc-900">{notes.length}</p>
            <p class="eyebrow mt-0.5">Sharing</p>
          </div>
          <div>
            <p class="font-serif text-2xl text-zinc-900">{projects.length}</p>
            <p class="eyebrow mt-0.5">Projects</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="/notes/"
            class="inline-flex items-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700"
          >
            阅读分享
            <span class="ml-2">→</span>
          </a>
          <a
            href="/about/"
            class="inline-flex items-center rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-500"
          >
            关于我
          </a>
        </div>
      </div>
    </aside>

    <div class="min-w-0 space-y-12 lg:col-span-8">
      <section>
        <p class="eyebrow">公开更新中的知识分享主站</p>
        <h2 class="mt-3 font-serif text-5xl leading-[1.05] tracking-tight text-zinc-900 sm:text-6xl">
          Hi，我是 Muxin。
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-zinc-500">
          把 AI 工程、项目实践和个人表达，整理成能长期沉淀的公开内容。
        </p>
      </section>

      <section class="grid gap-6 lg:grid-cols-12">
        {featuredNote && (
          <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-8 lg:col-span-8">
            <div class="flex items-center justify-between gap-4">
              <p class="eyebrow">最新分享</p>
              <time class="text-xs text-zinc-400" datetime={featuredNote.data.pubDate.toISOString()}>
                {dateFormatter.format(featuredNote.data.pubDate)}
              </time>
            </div>

            <a href={`/notes/${featuredNote.id}/`} class="group mt-4 block">
              <h2 class="max-w-3xl font-serif text-xl sm:text-2xl leading-tight tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600">
                {featuredNote.data.title}
              </h2>
              <p class="mt-3 max-w-3xl text-sm leading-7 text-zinc-500">
                {featuredNote.data.description}
              </p>
            </a>

            <div class="mt-5 flex flex-wrap items-center gap-1.5">
              <a href={`/notes/category/${noteCategoryMeta[featuredNote.data.category].slug}/`} class="tag-accent">
                {featuredNote.data.category}
              </a>
              {featuredNote.data.tags.slice(0, 2).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <a
              href={`/notes/${featuredNote.id}/`}
              class="mt-6 inline-flex items-center text-sm font-medium text-zinc-700 transition hover:text-zinc-900"
            >
              继续阅读
              <span class="ml-2">→</span>
            </a>
          </article>
        )}

        <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7 lg:col-span-4">
          <p class="eyebrow">当前关注点</p>
          <ul class="mt-4 space-y-3">
            {currentFocus.map((item) => (
              <li class="flex gap-2.5 text-sm leading-7 text-zinc-600">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      </section>

      {recentNotes.length > 0 && (
        <section class="grid gap-4 sm:grid-cols-2">
          {recentNotes.map((note) => (
            <article class="rounded-2xl border border-zinc-200 bg-white p-5 transition duration-200 hover:border-zinc-400">
              <div class="flex items-center justify-between gap-3">
                <a
                  href={`/notes/category/${noteCategoryMeta[note.data.category].slug}/`}
                  class="tag-accent"
                >
                  {note.data.category}
                </a>
                <time class="text-xs text-zinc-400" datetime={note.data.pubDate.toISOString()}>
                  {dateFormatter.format(note.data.pubDate)}
                </time>
              </div>

              <a href={`/notes/${note.id}/`} class="group mt-4 block">
                <h2 class="font-serif text-xl tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600">
                  {note.data.title}
                </h2>
                <p class="mt-2 text-sm leading-7 text-zinc-500">
                  {note.data.description}
                </p>
              </a>
            </article>
          ))}
        </section>
      )}

      <section>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">公开项目</p>
            <h2 class="mt-2 font-serif text-3xl tracking-tight text-zinc-900">
              不是只放结果，而是把过程也拆出来
            </h2>
          </div>
          <a
            href="/projects/"
            class="text-sm font-medium text-zinc-500 transition hover:text-zinc-900"
          >
            查看全部 →
          </a>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
