---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import { profile, projects, skillGroups, timeline } from "../data";

const skillCount = skillGroups.reduce((total, group) => total + group.items.length, 0);
---

<BaseLayout title="About | muxin.space" description="关于我、关于这个站点、关于为什么持续分享。">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <ProfileAvatar
          src={profile.avatar}
          alt={`${profile.name} 的头像`}
          sizeClass="h-20 w-20"
          badge="关于我"
        />

        <div class="mt-5">
          <p class="eyebrow">Identity</p>
          <h1 class="mt-2 font-serif text-3xl tracking-tight text-zinc-900">{profile.name}</h1>
          <p class="mt-3 text-sm leading-7 text-zinc-500">{profile.description}</p>
        </div>

        <div class="mt-5 flex flex-wrap gap-2 text-sm text-zinc-500">
          <a
            href="mailto:hello@muxin-space.top"
            class="rounded-full border border-zinc-300 bg-white px-3.5 py-1.5 text-xs transition hover:border-zinc-500"
          >
            hello@muxin-space.top
          </a>
          <span class="tag-accent">{profile.badge}</span>
        </div>

        <div class="mt-6 flex items-center gap-5">
          <div>
            <p class="font-serif text-xl text-zinc-900">{timeline.length}</p>
            <p class="eyebrow mt-0.5">Timeline</p>
          </div>
          <div>
            <p class="font-serif text-xl text-zinc-900">{skillCount}</p>
            <p class="eyebrow mt-0.5">Skills</p>
          </div>
          <div>
            <p class="font-serif text-xl text-zinc-900">{projects.length}</p>
            <p class="eyebrow mt-0.5">Projects</p>
          </div>
        </div>
      </div>

      <div class="mt-5 rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <p class="eyebrow">公开身份切面</p>
        <ul class="mt-4 space-y-3">
          <li class="flex gap-2.5 text-sm leading-7 text-zinc-600">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
            <span>把项目过程拆成知识分享，而不是只在最后摆一个成品截图。</span>
          </li>
          <li class="flex gap-2.5 text-sm leading-7 text-zinc-600">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
            <span>也是二次元摄影师，希望把技术感和个人审美放进同一个长期作品里。</span>
          </li>
        </ul>
      </div>
    </aside>

    <div class="min-w-0 space-y-12 lg:col-span-8">
      <section>
        <p class="eyebrow">持续更新中的个人坐标</p>
        <h2 class="mt-3 max-w-[16ch] font-serif text-4xl leading-[1.1] tracking-tight text-zinc-900 sm:text-5xl">
          把工程、分享和个人风格，放在同一个公开坐标系里。
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-8 text-zinc-500">
          这个页面不是传统简历页，而是我怎么做项目、怎么整理内容、怎么理解长期表达的公开说明。
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <p class="text-sm font-medium text-zinc-900">站点角色</p>
            <p class="mt-2 text-sm leading-7 text-zinc-500">
              作为公开工作台，承接文章、项目、复盘记录和内容分发的完整版沉淀。
            </p>
          </article>
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <p class="text-sm font-medium text-zinc-900">写作目标</p>
            <p class="mt-2 text-sm leading-7 text-zinc-500">
              尽量把每次实践写成可回看、可转发、可继续扩写的知识资产，而不是一次性动态。
            </p>
          </article>
          <article class="rounded-xl border border-zinc-200 bg-white p-4">
            <p class="text-sm font-medium text-zinc-900">工作方式</p>
            <p class="mt-2 text-sm leading-7 text-zinc-500">
              用项目驱动学习，用分享倒逼总结，把技术和审美一起做成长期有辨识度的作品。
            </p>
          </article>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-12">
        <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7 lg:col-span-7">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="eyebrow">近期轨迹</p>
              <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">从项目节点看自己的主线</h2>
            </div>
          </div>

          <div class="mt-5 space-y-4">
            {timeline.map((item) => (
              <div class="relative border-l border-zinc-200 pl-5">
                <p class="eyebrow">{item.period}</p>
                <h3 class="mt-1.5 font-serif text-xl tracking-tight text-zinc-900">{item.title}</h3>
                <p class="mt-2 text-sm leading-7 text-zinc-500">{item.description}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7 lg:col-span-5">
          <p class="eyebrow">技能地图</p>
          <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">现在稳定输出的能力组合</h2>

          <div class="mt-5 space-y-5">
            {skillGroups.map((group) => (
              <section>
                <div class="flex items-baseline justify-between">
                  <h3 class="text-sm font-medium text-zinc-900">{group.title}</h3>
                  <span class="text-xs text-zinc-400">{group.items.length} 项</span>
                </div>
                <div class="mt-2.5 h-1.5 w-full overflow-hidden rounded-full bg-zinc-100">
                  <div
                    class="h-full rounded-full bg-rose-400"
                    style={`width: ${Math.min(100, group.items.length * 18)}%`}
                  >
                  </div>
                </div>
                <div class="mt-2.5 flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="tag">{item}</span>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </article>
      </section>
    </div>
  </div>
</BaseLayout>
