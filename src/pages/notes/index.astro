---
import { getCollection } from "astro:content";
import NoteCard from "../../components/NoteCard.astro";
import SiteSearch from "../../components/SiteSearch.astro";
import { noteCategoryLabels, noteCategoryMeta } from "../../data";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categoryCounts = noteCategoryLabels.map((category) => ({
  label: category,
  count: notes.filter((note) => note.data.category === category).length,
  meta: noteCategoryMeta[category],
}));
---

<BaseLayout title="Sharing | muxin.space" description="AI 工程、前端实践、项目拆解与工作流分享。">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <section class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <p class="eyebrow">Sharing</p>
        <h1 class="mt-2 font-serif text-3xl leading-tight tracking-tight text-zinc-900">
          这里放的是我愿意公开讲清楚的内容。
        </h1>
        <p class="mt-3 text-sm leading-7 text-zinc-500">
          包括技术分享、项目复盘、工具实践和一些值得沉淀的思考。它们按时间归档，但目标不是堆数量，而是尽量做到可复现、可回看、可继续分发。
        </p>
        <div class="mt-5 tag-accent">
          共 {notes.length} 篇公开分享
        </div>

        <div class="mt-5 border-t border-zinc-100 pt-5">
          <p class="eyebrow">Search</p>
          <div class="mt-2.5">
            <SiteSearch />
          </div>
        </div>

        <div class="mt-5 space-y-2.5 border-t border-zinc-100 pt-5">
          <p class="eyebrow">Categories</p>
          <div class="flex flex-wrap gap-1.5">
            <a
              href="/notes/"
              class="rounded-full bg-zinc-900 px-3 py-1 text-xs font-medium text-white transition hover:bg-zinc-700"
            >
              全部 · {notes.length}
            </a>
            {categoryCounts.map(({ label, count, meta }) => (
              <a
                href={`/notes/category/${meta.slug}/`}
                class="tag transition hover:border-zinc-400"
              >
                {label} · {count}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="min-w-0 space-y-5 lg:col-span-8">
      <div class="grid gap-3 sm:grid-cols-3">
        {categoryCounts.map(({ label, count, meta }) => (
          <a
            href={`/notes/category/${meta.slug}/`}
            class="rounded-xl border border-zinc-200 bg-white p-4 transition duration-200 hover:border-zinc-400"
          >
            <p class="text-sm font-medium text-zinc-900">{label}</p>
            <p class="mt-1.5 font-serif text-xl tracking-tight text-zinc-900">{count} 篇</p>
            <p class="mt-1.5 text-xs leading-6 text-zinc-500">{meta.prompt}</p>
          </a>
        ))}
      </div>

      <div class="space-y-4">
        {notes.map((note) => <NoteCard note={note} />)}
      </div>
    </section>
  </div>
</BaseLayout>
