---
import { getCollection, render } from "astro:content";
import { noteCategoryMeta } from "../../data";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateText = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.pubDate);
const categoryMeta = noteCategoryMeta[entry.data.category];
---

<BaseLayout
  title={`${entry.data.title} | muxin.space`}
  description={entry.data.description}
  type="article"
>
  <div class="grid gap-6 lg:gap-12 md:grid-cols-12">
    <aside class="md:col-span-4 md:sticky md:top-24 md:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-5 sm:p-6">
        <a
          href="/notes/"
          class="inline-flex items-center rounded-full border border-zinc-300 px-3 py-1.5 text-xs sm:text-sm font-medium text-zinc-600 transition hover:border-zinc-500"
        >
          ← 返回分享列表
        </a>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <a href={`/notes/category/${categoryMeta.slug}/`} class="tag-accent">
            {entry.data.category}
          </a>
          <time class="text-xs text-zinc-400" datetime={entry.data.pubDate.toISOString()}>
            {dateText}
          </time>
        </div>

        <h1 class="mt-3 font-serif text-xl leading-snug tracking-tight text-zinc-900 md:text-2xl">
          {entry.data.title}
        </h1>
        <p class="mt-2 text-sm leading-7 text-zinc-500">
          {entry.data.description}
        </p>

        <div class="mt-4 flex flex-wrap gap-1.5 border-t border-zinc-100 pt-4">
          {entry.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </aside>

    <article class="md:col-span-8">
      <div class="rounded-2xl border border-zinc-200 bg-white p-5 sm:p-7 md:p-10">
        <div class="article-prose prose prose-zinc max-w-none prose-headings:font-serif prose-headings:tracking-tight prose-a:text-zinc-900 prose-a:underline prose-strong:text-zinc-900 2xl:max-w-[86ch]">
          <Content />
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
