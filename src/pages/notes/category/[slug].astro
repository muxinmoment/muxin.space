---
import { getCollection } from "astro:content";
import NoteCard from "../../../components/NoteCard.astro";
import { getNoteCategoryBySlug, noteCategoryLabels, noteCategoryMeta } from "../../../data";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return noteCategoryLabels.map((category) => ({
    params: { slug: noteCategoryMeta[category].slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const meta = noteCategoryMeta[category];
const notes = (await getCollection("notes", ({ data }) => !data.draft && data.category === category))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const currentCategory = getNoteCategoryBySlug(meta.slug);
---

<BaseLayout
  title={`${category} | muxin.space`}
  description={meta.description}
>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <section class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <a
          href="/notes/"
          class="inline-flex items-center rounded-full border border-zinc-300 px-3.5 py-1.5 text-sm font-medium text-zinc-600 transition hover:border-zinc-500"
        >
          ← 返回全部分享
        </a>

        <p class="mt-6 eyebrow">Category</p>
        <h1 class="mt-2 font-serif text-3xl leading-tight tracking-tight text-zinc-900">
          {category}
        </h1>
        <p class="mt-3 text-sm leading-7 text-zinc-500">
          {meta.description}
        </p>

        <div class="mt-5 tag-accent">
          共 {notes.length} 篇
        </div>

        <div class="mt-5 space-y-2.5 border-t border-zinc-100 pt-5">
          <p class="eyebrow">Browse</p>
          <div class="flex flex-wrap gap-1.5">
            <a
              href="/notes/"
              class="tag transition hover:border-zinc-400"
            >
              全部分享
            </a>
            {noteCategoryLabels.map((label) => (
              <a
                href={`/notes/category/${noteCategoryMeta[label].slug}/`}
                class:list={[
                  label === currentCategory ? "tag-accent" : "tag",
                  "transition hover:border-zinc-400",
                ]}
              >
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="min-w-0 space-y-4 lg:col-span-8">
      {notes.map((note) => <NoteCard note={note} />)}
    </section>
  </div>
</BaseLayout>
