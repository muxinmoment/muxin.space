---
import { execSync } from "node:child_process";
import BaseLayout from "../layouts/BaseLayout.astro";
import { currentFocus } from "../data";

// 从 git 提交历史读取本文件最后修改时间，避免硬码日期忘更新导致失真
let updatedAt = new Date();
try {
  const isoDate = execSync('git log -1 --format=%cI -- src/pages/now.astro', {
    cwd: process.cwd(),
    encoding: "utf-8",
  }).trim();
  if (isoDate) updatedAt = new Date(isoDate);
} catch {
  // git 不可用时回退到构建时间，不阻塞构建
}

const dateText = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(updatedAt);

const daysAgo = Math.max(
  0,
  Math.floor((Date.now() - updatedAt.getTime()) / (1000 * 60 * 60 * 24))
);
---

<BaseLayout title="当前副本 | muxin.space" description="我现在在忙什么、在学什么、状态怎么样。">
  <div class="mx-auto max-w-2xl">
    <div class="reveal flex items-center gap-2.5">
      <span class="relative flex h-2 w-2 items-center justify-center">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-rose-300 opacity-70"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-rose-500"></span>
      </span>
      <p class="eyebrow">Current quest · 更新于 {dateText}{daysAgo > 0 && `（${daysAgo} 天前）`}</p>
    </div>

    <h1 class="reveal mt-4 font-serif text-4xl tracking-tight text-zinc-900 sm:text-5xl">
      当前副本：持续升级中。
    </h1>
    <p class="reveal mt-4 text-base leading-8 text-zinc-500">
      这不是一份静态简介，而是一个会更新的角色面板：主线任务、技能树和一些不太正经的支线都会放在这里。
    </p>

    <section class="reveal mt-8 rounded-3xl border border-violet-200 bg-[linear-gradient(135deg,#faf5ff_0%,#fff1f2_100%)] p-6 sm:p-7">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow text-violet-500">Player status</p>
          <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">Muxin · AI 工程师学徒</h2>
        </div>
        <span class="rounded-full border border-violet-200 bg-white/70 px-3 py-1 text-xs font-medium text-violet-700">Lv. 21</span>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/80 bg-white/70 p-4"><p class="text-xs text-zinc-400">主线进度</p><div class="mt-3 h-2 rounded-full bg-violet-100"><div class="h-full w-[72%] rounded-full bg-violet-500"></div></div><p class="mt-2 text-xs text-zinc-500">秋招上岸 · 72%</p></div>
        <div class="rounded-2xl border border-white/80 bg-white/70 p-4"><p class="text-xs text-zinc-400">当前装备</p><p class="mt-3 font-medium text-zinc-900">Agent Harness</p><p class="mt-1 text-xs text-zinc-500">正在强化中</p></div>
        <div class="rounded-2xl border border-white/80 bg-white/70 p-4"><p class="text-xs text-zinc-400">被动技能</p><p class="mt-3 font-medium text-zinc-900">看番回血</p><p class="mt-1 text-xs text-zinc-500">摄影审美 +10</p></div>
      </div>
    </section>

    <section class="reveal mt-6 rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="eyebrow">Main quests</p>
          <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">正在推进</h2>
        </div>
        <span class="tag-accent">进行中</span>
      </div>
      <ul class="mt-5 space-y-3">
        {currentFocus.map((item) => (
          <li class="flex items-start justify-between gap-3 rounded-xl border border-zinc-100 bg-zinc-50 px-4 py-3 text-sm leading-7 text-zinc-600 transition hover:border-violet-200 hover:bg-violet-50/40">
            <span class="flex gap-2.5">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>
              <span>{item.text}</span>
            </span>
            <span class="tag shrink-0">{item.status}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="reveal mt-6 rounded-2xl border border-zinc-900 bg-zinc-900 p-6 text-white sm:p-7">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="eyebrow text-zinc-500">Side quest generator</p>
          <p id="side-quest" class="mt-3 text-base leading-8 text-zinc-200">今天也要把一个小问题弄明白。</p>
        </div>
        <button id="reroll-quest" type="button" class="shrink-0 rounded-full border border-zinc-700 px-3.5 py-2 text-xs font-medium text-zinc-300 transition hover:border-violet-400 hover:text-white">换一条支线</button>
      </div>
    </section>

    <section class="reveal mt-6 rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
      <p class="eyebrow">生活的另一面</p>
      <p class="mt-3 text-sm leading-7 text-zinc-600">
        老二次元，喜欢看番；也当过一段时间的二次元摄影师，技术之外还是想把这部分审美带进这个网站。
      </p>
    </section>

    <div class="reveal mt-10 flex flex-wrap gap-3">
      <a
        href="/notes/"
        class="inline-flex items-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700"
      >
        看看我在写什么
      </a>
      <a
        href="/about/"
        class="inline-flex items-center rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-500"
      >
        关于我
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  const questLines = [
    "看一集番，给大脑做一次低成本缓存。",
    "把一个失败实验写成别人能看懂的复盘。",
    "拍一张喜欢的照片，提醒自己别只活在终端里。",
    "给博客修一个小细节，让它更像自己的房间。",
  ];

  function initQuestReroll() {
    const button = document.querySelector<HTMLButtonElement>("#reroll-quest");
    const target = document.querySelector<HTMLElement>("#side-quest");
    if (!button || !target || button.dataset.ready === "true") return;
    button.addEventListener("click", () => {
      const current = target.textContent;
      const options = questLines.filter((line) => line !== current);
      target.textContent = options[Math.floor(Math.random() * options.length)];
    });
    button.dataset.ready = "true";
  }

  initQuestReroll();
  document.addEventListener("astro:page-load", initQuestReroll);
</script>
