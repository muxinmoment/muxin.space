---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    name: "Aido",
    subtitle: "个人排期与规划智能体系统",
    period: "2026.02 — 至今",
    role: "项目负责人 · 核心 AI 后端开发",
    summary:
      "一个面向个人用户的 AI 效能管理产品。它不只回答问题，而是把目标拆解、排期、执行反馈和偏好记忆串成一个可以持续工作的系统。",
    result: "把 Planner 从 LangGraph 迁移到自研 Harness，并用真实实验数据决定架构取舍。",
    stack: ["Agent Harness", "FastAPI", "Vue3", "PostgreSQL"],
    points: [
      "设计 AgentLoop、ToolRegistry 与 LoopBudget，覆盖循环控制、工具注册和预算熔断。",
      "搭建四层偏好记忆系统，让时长偏好、情绪反馈等信息能被静默提取并持续反刍。",
      "围绕按需提取与全量装配做三轮实验：context token 降低 82–89%，最终定位瓶颈是模型工具调用能力而非架构本身。",
    ],
    links: [
      { label: "在线体验", href: "http://121.43.163.163/" },
      { label: "Harness 复盘", href: "/notes/giving-aido-planner-a-harness-to-ask-for-what-it-needs/" },
    ],
    tone: "rose",
  },
  {
    number: "02",
    name: "KeeperKit",
    subtitle: "TRPG 规则 RAG 助手",
    period: "2026.03 — 至今",
    role: "项目负责人 · 产品与全栈开发",
    summary:
      "一个本地优先的 TRPG AI 工具箱，先从规则书问答切入，再逐步扩展到模组管理、时间线整理和 NPC / 线索摘要。",
    result: "从零搭建可替换的 RAG 流水线，并把每一步实现沉淀成独立文档。",
    stack: ["FastAPI", "ChromaDB", "BGE", "LangGraph"],
    points: [
      "完成文档加载、切块、向量化、检索、精排与生成的完整链路，持续迭代 MVP → V1.0 → V1.2。",
      "抽象 Embedding、VectorStore、Reranker 和 Generator 接口，支持组件自由替换升级。",
      "基于 LangGraph 搭建模组助手工作流，结合 PostgreSQL 会话记忆整理时间线并抽取 NPC / 线索摘要。",
    ],
    links: [
      { label: "查看项目主线", href: "/projects/#project-keeperkit" },
      { label: "项目页面", href: "/notes/" },
    ],
    tone: "violet",
  },
  {
    number: "03",
    name: "OPPO 小布助手",
    subtitle: "对话短文本语义匹配系统",
    period: "2025.10 — 2026.01",
    role: "项目负责人 · 算法开发",
    summary:
      "基于公开语音助手数据集完成的一次端侧语义匹配实训，重点探索模型轻量化、对比学习和推理效率之间的平衡。",
    result: "在保持匹配效果的同时，将模型压缩到更适合低延迟推理的规模。",
    stack: ["PyTorch", "RoBERTa", "SimCSE", "ONNX"],
    points: [
      "处理 45 万条脱敏对话数据，完成数据清洗、训练、评估和端侧推理验证。",
      "将 12 层 BERT 压缩为 RoBERTa-4Layers，参数量降低 65%，推理速度提升约 3 倍。",
      "结合 SimCSE 对比学习与 FGM 对抗训练，自测 AUC 达到 0.93。",
    ],
    links: [{ label: "返回项目总览", href: "/projects/" }],
    tone: "amber",
  },
];

const toneClasses = {
  rose: {
    badge: "border-rose-200 bg-rose-50 text-rose-700",
    dot: "bg-rose-400",
    line: "border-rose-200",
  },
  violet: {
    badge: "border-violet-200 bg-violet-50 text-violet-700",
    dot: "bg-violet-400",
    line: "border-violet-200",
  },
  amber: {
    badge: "border-amber-200 bg-amber-50 text-amber-700",
    dot: "bg-amber-400",
    line: "border-amber-200",
  },
};
---

<BaseLayout
  title="Portfolio | muxin.space"
  description="AI 应用、Agent、RAG 与模型工程项目作品集。"
>
  <div class="mx-auto max-w-6xl">
    <section class="grid gap-8 border-b border-zinc-200 pb-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-16">
      <div class="reveal">
        <p class="eyebrow">Selected work · 2025—2026</p>
        <h1 class="mt-4 max-w-3xl font-serif text-5xl leading-[1.08] tracking-tight text-zinc-900 sm:text-7xl">
          把想法做成<br /><span class="text-rose-600">能被验证的系统。</span>
        </h1>
      </div>
      <div class="reveal lg:pb-1">
        <p class="text-base leading-8 text-zinc-600">
          这里放我最愿意在面试里展开讲的三个项目：从 Agent Harness，到 RAG 工程化，再到模型轻量化。重点不是堆技术名词，而是记录我如何拆问题、做实验、接受结果并继续迭代。
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="/resume/" class="inline-flex items-center rounded-full bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-zinc-700">
            查看简历 <span class="ml-2">→</span>
          </a>
          <a href="/notes/" class="inline-flex items-center rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-500">
            阅读复盘 <span class="ml-2">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="grid gap-3 border-b border-zinc-200 py-7 text-sm text-zinc-500 sm:grid-cols-3">
      <div><span class="font-serif text-2xl text-zinc-900">3</span><span class="ml-2">个长期项目</span></div>
      <div><span class="font-serif text-2xl text-zinc-900">AI</span><span class="ml-2">应用与工程落地</span></div>
      <div><span class="font-serif text-2xl text-zinc-900">从 0 到 1</span><span class="ml-2">独立拆解与实现</span></div>
    </section>

    <section class="mt-12 grid gap-5 lg:grid-cols-[1.05fr_0.95fr]">
      <article class="reveal rounded-3xl border border-zinc-200 bg-white p-6 sm:p-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow">Evidence dashboard</p>
            <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">项目结果，先看数字</h2>
          </div>
          <span class="text-xs text-zinc-400">公开项目与脱敏实践</span>
        </div>

        <div class="mt-8 space-y-7">
          <div>
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium text-zinc-700">AI 测试平台 · 真机通过率</span>
              <span class="font-serif text-lg text-zinc-900">72.7% → 90.5%</span>
            </div>
            <div class="mt-3 grid grid-cols-[3.2rem_1fr] items-center gap-3 text-xs text-zinc-400">
              <span>Before</span><div class="h-2.5 rounded-full bg-zinc-100"><div class="h-full w-[73%] rounded-full bg-zinc-300"></div></div>
              <span>After</span><div class="h-2.5 rounded-full bg-rose-100"><div class="h-full w-[91%] rounded-full bg-rose-500"></div></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium text-zinc-700">AI 测试平台 · 用例有效率</span>
              <span class="font-serif text-lg text-zinc-900">34.9% → 78.6%</span>
            </div>
            <div class="mt-3 grid grid-cols-[3.2rem_1fr] items-center gap-3 text-xs text-zinc-400">
              <span>Before</span><div class="h-2.5 rounded-full bg-zinc-100"><div class="h-full w-[35%] rounded-full bg-zinc-300"></div></div>
              <span>After</span><div class="h-2.5 rounded-full bg-violet-100"><div class="h-full w-[79%] rounded-full bg-violet-500"></div></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between text-sm">
              <span class="font-medium text-zinc-700">Aido · context token 消耗</span>
              <span class="font-serif text-lg text-zinc-900">↓ 82–89%</span>
            </div>
            <div class="mt-3 grid grid-cols-[3.2rem_1fr] items-center gap-3 text-xs text-zinc-400">
              <span>Original</span><div class="h-2.5 rounded-full bg-zinc-100"><div class="h-full w-full rounded-full bg-zinc-300"></div></div>
              <span>Optimized</span><div class="h-2.5 rounded-full bg-amber-100"><div class="h-full w-[18%] rounded-full bg-amber-500"></div></div>
            </div>
          </div>
        </div>
      </article>

      <article class="reveal rounded-3xl border border-zinc-200 bg-zinc-900 p-6 text-white sm:p-8">
        <div>
          <p class="eyebrow text-zinc-500">Aido architecture</p>
          <h2 class="mt-2 font-serif text-2xl tracking-tight">从请求到可执行的闭环</h2>
        </div>
        <svg class="mt-8 h-auto w-full" viewBox="0 0 620 220" role="img" aria-label="Aido Agent Harness 架构流程图">
          <defs>
            <marker id="portfolio-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
              <path d="M0,0 L8,4 L0,8 Z" fill="#a1a1aa"></path>
            </marker>
          </defs>
          <path d="M142 72 H190 M292 72 H340 M442 72 H490" stroke="#71717a" stroke-width="2" marker-end="url(#portfolio-arrow)"></path>
          <path d="M391 104 V156 H244 V104" fill="none" stroke="#71717a" stroke-width="2" stroke-dasharray="5 5" marker-end="url(#portfolio-arrow)"></path>
          <g>
            <rect x="18" y="42" width="124" height="60" rx="14" fill="#27272a" stroke="#71717a"></rect>
            <text x="80" y="68" fill="#f4f4f5" text-anchor="middle" font-size="14">用户目标</text>
            <text x="80" y="87" fill="#a1a1aa" text-anchor="middle" font-size="11">自然语言输入</text>
          </g>
          <g>
            <rect x="190" y="42" width="102" height="60" rx="14" fill="#4c0519" stroke="#fb7185"></rect>
            <text x="241" y="68" fill="#fff1f2" text-anchor="middle" font-size="14">Planner</text>
            <text x="241" y="87" fill="#fda4af" text-anchor="middle" font-size="11">AgentLoop</text>
          </g>
          <g>
            <rect x="340" y="42" width="102" height="60" rx="14" fill="#172554" stroke="#818cf8"></rect>
            <text x="391" y="68" fill="#eef2ff" text-anchor="middle" font-size="14">Tools</text>
            <text x="391" y="87" fill="#a5b4fc" text-anchor="middle" font-size="11">Registry</text>
          </g>
          <g>
            <rect x="490" y="42" width="112" height="60" rx="14" fill="#422006" stroke="#fbbf24"></rect>
            <text x="546" y="68" fill="#fffbeb" text-anchor="middle" font-size="14">执行结果</text>
            <text x="546" y="87" fill="#fcd34d" text-anchor="middle" font-size="11">反馈与记忆</text>
          </g>
          <text x="317" y="184" fill="#a1a1aa" text-anchor="middle" font-size="11">LoopBudget：预算熔断 · 失败可回退 · 结果可反刍</text>
        </svg>
      </article>
    </section>

    <section class="reveal mt-5 rounded-3xl border border-zinc-200 bg-white p-6 sm:p-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Project timeline</p>
          <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">三条线，逐渐汇到 AI 工程</h2>
        </div>
        <p class="text-sm text-zinc-400">从模型实验 → RAG 产品 → Agent 系统</p>
      </div>
      <div class="mt-8 overflow-x-auto pb-2">
        <div class="min-w-[680px]">
          <div class="grid grid-cols-[8rem_repeat(4,1fr)] gap-2 text-xs text-zinc-400">
            <span></span><span>2025 Q4</span><span>2026 Q1</span><span>2026 Q2</span><span>2026 Q3+</span>
          </div>
          <div class="mt-4 space-y-3 text-sm">
            <div class="grid grid-cols-[8rem_repeat(4,1fr)] items-center gap-2">
              <span class="font-medium text-zinc-700">模型与推理</span><span class="h-2 rounded-l-full bg-amber-400"></span><span class="h-2 rounded-r-full bg-amber-400"></span><span></span><span></span>
            </div>
            <div class="grid grid-cols-[8rem_repeat(4,1fr)] items-center gap-2">
              <span class="font-medium text-zinc-700">RAG 产品化</span><span></span><span class="h-2 rounded-l-full bg-violet-400"></span><span class="h-2 bg-violet-400"></span><span class="h-2 rounded-r-full bg-violet-400"></span>
            </div>
            <div class="grid grid-cols-[8rem_repeat(4,1fr)] items-center gap-2">
              <span class="font-medium text-zinc-700">Agent 系统</span><span></span><span class="h-2 rounded-l-full bg-rose-400"></span><span class="h-2 bg-rose-400"></span><span class="h-2 rounded-r-full bg-rose-400"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12 space-y-8">
      {projects.map((project) => {
        const tone = toneClasses[project.tone as keyof typeof toneClasses];
        return (
          <article id={project.name === "Aido" ? "aido" : project.name === "KeeperKit" ? "keeperkit" : "oppo"} class={`reveal overflow-hidden rounded-3xl border bg-white ${tone.line}`}>
            <div class="grid lg:grid-cols-[0.72fr_1.28fr]">
              <div class="border-b border-zinc-200/80 bg-zinc-50/70 p-6 sm:p-8 lg:border-b-0 lg:border-r">
                <div class="flex items-center justify-between gap-4">
                  <span class={`rounded-full border px-3 py-1 text-xs font-semibold ${tone.badge}`}>{project.number}</span>
                  <span class="text-xs font-medium tracking-wide text-zinc-400">{project.period}</span>
                </div>
                <h2 class="mt-12 font-serif text-4xl tracking-tight text-zinc-900">{project.name}</h2>
                <p class="mt-2 text-sm font-medium text-zinc-500">{project.subtitle}</p>
                <p class="mt-6 text-sm leading-7 text-zinc-600">{project.role}</p>
                <div class="mt-8 flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => <span class="tag">{tech}</span>)}
                </div>
              </div>
              <div class="p-6 sm:p-8 lg:p-10">
                <p class="max-w-2xl text-lg leading-8 text-zinc-700">{project.summary}</p>
                <div class="mt-7 rounded-2xl border border-zinc-100 bg-zinc-50 px-5 py-4">
                  <p class="eyebrow">What changed</p>
                  <p class="mt-2 text-sm font-medium leading-7 text-zinc-900">{project.result}</p>
                </div>
                <ul class="mt-7 space-y-4">
                  {project.points.map((point) => (
                    <li class="flex gap-3 text-sm leading-7 text-zinc-600">
                      <span class={`mt-3 h-1.5 w-1.5 shrink-0 rounded-full ${tone.dot}`}></span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-8 flex flex-wrap gap-4 border-t border-zinc-100 pt-5">
                  {project.links.map((link) => (
                    <a href={link.href} class="text-sm font-medium text-zinc-700 transition hover:text-rose-600">
                      {link.label} <span class="ml-1">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <section class="mt-12 rounded-3xl border border-zinc-200 bg-zinc-900 p-7 text-white sm:p-10">
      <p class="eyebrow text-zinc-500">How I work</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <h2 class="font-serif text-3xl leading-tight tracking-tight sm:text-4xl">先把问题说清楚，再让系统跑起来。</h2>
        <p class="max-w-2xl text-sm leading-7 text-zinc-300">
          我喜欢从可验证的小闭环开始：明确目标，拆出最小系统，记录关键指标，再根据真实结果决定继续放大、换方案，还是及时收窄。项目里的失败尝试同样值得留下，因为它们通常比最终的技术栈更能说明问题。
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
