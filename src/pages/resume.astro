---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data";
import {
  education,
  experiences,
  resumeHighlights,
  resumeIntent,
  resumeProjects,
} from "../data/resume";
---

<BaseLayout
  title="经历 | muxin.space"
  description="教育背景、实习经历、项目经历与技能概览（公开信息版）。"
>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
        <p class="eyebrow">Resume</p>
        <h1 class="mt-2 font-serif text-3xl leading-tight tracking-tight text-zinc-900">
          {profile.name} 的经历概览
        </h1>
        <p class="mt-3 text-sm leading-7 text-zinc-500">
          {resumeIntent.summary}
        </p>

        <div class="mt-5 flex flex-wrap gap-1.5">
          {resumeIntent.locations.map((city) => (
            <span class="tag">{city}</span>
          ))}
        </div>

        <div class="mt-5 rounded-xl border border-zinc-100 bg-zinc-50 px-4 py-3">
          <p class="eyebrow">Target</p>
          <p class="mt-1.5 text-sm font-medium text-zinc-900">{resumeIntent.headline}</p>
        </div>

        <a
          href="mailto:hello@muxin-space.top"
          class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-zinc-700"
        >
          联系我 · hello@muxin-space.top
        </a>

        <p class="mt-3 text-xs leading-6 text-zinc-400">
          这个页面是简历的公开精简版，只保留专业信息，联系方式仅公开邮箱。完整简历请邮件联系获取。
        </p>
      </div>
    </aside>

    <div class="min-w-0 space-y-12 lg:col-span-8">
      <section>
        <p class="eyebrow">核心能力速览</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {resumeHighlights.map((item) => (
            <span class="tag-accent">{item}</span>
          ))}
        </div>
      </section>

      <section>
        <p class="eyebrow">教育背景</p>
        <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">Education</h2>

        <div class="mt-5 space-y-4">
          {education.map((item) => (
            <article class="rounded-2xl border border-zinc-200 bg-white p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-serif text-xl tracking-tight text-zinc-900">
                  {item.school} · {item.major}
                </h3>
                <span class="text-sm text-zinc-400">{item.period}</span>
              </div>
              <p class="mt-1 text-sm text-zinc-500">{item.degree}</p>
              <ul class="mt-3 space-y-1.5">
                {item.details.map((detail) => (
                  <li class="flex gap-2.5 text-sm leading-7 text-zinc-600">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400"></span>
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section>
        <p class="eyebrow">实习经历</p>
        <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">Experience</h2>

        <div class="mt-5 space-y-4">
          {experiences.map((item) => (
            <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-serif text-xl tracking-tight text-zinc-900">{item.org}</h3>
                <span class="text-sm text-zinc-400">{item.period}</span>
              </div>
              <p class="mt-1 text-sm font-medium text-zinc-600">{item.role}</p>
              <p class="mt-3 text-sm leading-7 text-zinc-500">{item.summary}</p>

              <ul class="mt-4 space-y-2">
                {item.highlights.map((point) => (
                  <li class="flex gap-2.5 text-sm leading-7 text-zinc-600">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {item.stack.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section>
        <p class="eyebrow">项目经历</p>
        <h2 class="mt-2 font-serif text-2xl tracking-tight text-zinc-900">Projects</h2>

        <div class="mt-5 space-y-4">
          {resumeProjects.map((item) => (
            <article class="rounded-2xl border border-zinc-200 bg-white p-6 sm:p-7">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-serif text-xl tracking-tight text-zinc-900">{item.name}</h3>
                <span class="text-sm text-zinc-400">{item.period}</span>
              </div>
              <p class="mt-1 text-sm font-medium text-zinc-600">{item.role}</p>
              <p class="mt-3 text-sm leading-7 text-zinc-500">{item.summary}</p>

              <ul class="mt-4 space-y-2">
                {item.highlights.map((point) => (
                  <li class="flex gap-2.5 text-sm leading-7 text-zinc-600">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rose-400"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {item.stack.map((tech) => (
                  <span class="tag">{tech}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
