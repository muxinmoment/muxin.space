---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const memos = await getCollection("memo", ({ data }) => !data.draft);
  return memos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateText = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(entry.data.pubDate);
---

<BaseLayout title={`${entry.data.title} | 小木专栏 | muxin.space`} description={entry.data.description}>
  <div class="mx-auto max-w-2xl">
    <a
      href="/memo/"
      class="inline-flex items-center rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-xs sm:px-4 sm:py-2 sm:text-sm font-medium text-zinc-600 transition hover:border-amber-200 hover:text-amber-600"
    >
      ← 返回小木专栏
    </a>

    <article class="mt-6 rounded-2xl md:rounded-[2rem] border border-zinc-100 bg-white p-5 sm:p-8 md:p-10 shadow-[0_8px_24px_rgba(24,24,27,0.03)] md:shadow-[0_12px_36px_rgba(24,24,27,0.04)]">
      <div class="flex items-center gap-2 text-sm text-amber-600">
        <span>🪵</span>
        <span>小木</span>
        <span class="text-zinc-300">·</span>
        <time class="text-zinc-400" datetime={entry.data.pubDate.toISOString()}>
          {dateText}
        </time>
      </div>

      <h1 class="mt-4 font-serif text-2xl sm:text-3xl md:text-4xl leading-snug sm:leading-tight tracking-tight text-zinc-900">
        {entry.data.title}
      </h1>

      <div class="mt-4 flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
            {tag}
          </span>
        ))}
      </div>

      <div class="mt-8 article-prose prose prose-zinc max-w-none prose-headings:font-serif prose-headings:tracking-tight prose-a:text-amber-600 prose-a:no-underline hover:prose-a:text-amber-700 prose-strong:text-zinc-900">
        <Content />
      </div>

      <div class="mt-10 border-t border-zinc-100 pt-6">
        <a
          href="/memo/"
          class="inline-flex items-center text-sm font-medium text-zinc-500 transition hover:text-amber-600"
        >
          ← 返回小木专栏
        </a>
      </div>
    </article>
  </div>
</BaseLayout>
