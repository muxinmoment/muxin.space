---
import type { Project } from "../data";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const maxStackTags = 3;
const visibleStack = project.stack.slice(0, maxStackTags);
const hiddenStackCount = project.stack.length - visibleStack.length;
---

<article class="rounded-2xl border border-zinc-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-400 hover:shadow-[0_10px_24px_rgba(0,0,0,0.05)]">
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-serif text-2xl tracking-tight text-zinc-900">{project.name}</h3>
    <span class="eyebrow shrink-0">{project.status}</span>
  </div>

  <p class="mt-3 text-sm leading-7 text-zinc-500">{project.summary}</p>
  <p class="mt-2 text-xs leading-6 text-zinc-400">{project.highlights.join(" · ")}</p>

  <div class="mt-4 flex flex-wrap items-center gap-1.5">
    {visibleStack.map((item) => (
      <span class="tag">{item}</span>
    ))}
    {hiddenStackCount > 0 && (
      <span class="text-xs text-zinc-400">+{hiddenStackCount}</span>
    )}
  </div>

  {project.liveUrl && (
    <div class="mt-5">
      <a
        href={project.liveUrl}
        target="_blank"
        rel="noreferrer"
        class="group inline-flex items-center text-sm font-medium text-zinc-700 transition duration-200 hover:text-zinc-900"
      >
        {project.liveLabel ?? "查看项目"}
        <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">↗</span>
      </a>
    </div>
  )}
</article>
