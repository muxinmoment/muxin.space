  .diorama-hotspot:hover, .diorama-hotspot[data-active="true"] { transform: translate(-2px, -2px); background: #704c9e; }
  .hotspot-anime { left: 12%; top: 48%; }.hotspot-photo { left: 43%; top: 45%; }.hotspot-notes { left: 72%; top: 54%; }.hotspot-memo { right: 7%; top: 72%; }
  .wander-easter-egg { position: absolute; left: 57%; top: 34%; width: 1.5rem; height: 1.5rem; border: 0; border-radius: 50%; background: transparent; color: #ffe0a0; font-size: .9rem; opacity: .6; transition: transform .2s, opacity .2s, text-shadow .2s; }.wander-easter-egg:hover, .wander-easter-egg:focus-visible { opacity: 1; transform: scale(1.2); text-shadow: 0 0 8px #ffb45f; outline: none; }.wander-easter-egg[data-found="true"] { color: #ffb45f; opacity: 1; }
