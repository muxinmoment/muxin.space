        <button type="button" data-room-camera="photo" class="diorama-hotspot hotspot-photo">照片墙</button>
        <button type="button" data-room-camera="notes" class="diorama-hotspot hotspot-notes">书桌</button>
        <button type="button" data-room-camera="memo" class="diorama-hotspot hotspot-memo">收音机</button>
        <button type="button" class="wander-easter-egg" data-wander-easter-egg aria-label="发现窗边的小彩蛋">✦</button>
      </div>
    </div>
