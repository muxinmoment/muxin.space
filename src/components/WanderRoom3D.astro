  .wander-3d-skip { position: absolute; right: 1rem; bottom: 1rem; color: #d0bed8; }
  .wander-game-panel { border-top: 3px solid #332449; background: #211a35; padding: 1.25rem 1.5rem 1.5rem; color: #fff7ed; }
  .wander-game-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }.wander-game-kicker { color: #ffd166; font-size: .65rem; letter-spacing: .16em; }.wander-game-heading h3 { margin-top: .35rem; font-family: var(--font-serif); font-size: 1.35rem; }.wander-game-close { border: 2px solid #5b4378; border-radius: .4rem; padding: .15rem .55rem; color: #f4d8ff; font-size: 1.25rem; line-height: 1; }.wander-game-copy { margin-top: .5rem; color: #d9c8e5; font-size: .8rem; line-height: 1.5rem; }
