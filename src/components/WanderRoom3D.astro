<style>
  .wander-diorama-shell { position: relative; margin-top: 2rem; overflow: hidden; border: 3px solid #2d1e3e; border-radius: 1rem; background: #211a35; color: #fff7ed; box-shadow: 5px 5px 0 #171225, 0 1.5rem 3rem rgba(45, 30, 62, .2); }
