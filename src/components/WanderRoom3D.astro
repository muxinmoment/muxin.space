  .wander-diorama-svg { display: none; }
  .diorama-layer { transition: transform .45s cubic-bezier(.22,.8,.28,1), opacity .3s; transform-origin: center; }
  .wander-pixel-layer[data-diorama-layer="sky"] { z-index: 1; }
  .wander-pixel-layer[data-diorama-layer="outside"] { z-index: 2; }
  .wander-pixel-layer[data-diorama-layer="room"] { z-index: 3; }
  .wander-pixel-layer[data-diorama-layer="objects"] { z-index: 4; }
  .wander-pixel-layer[data-diorama-layer="light"] { z-index: 5; pointer-events: none; mix-blend-mode: screen; opacity: .78; animation: wander-light-breathe 10s ease-in-out infinite; }
  .wander-pixel-layer[data-diorama-layer="foreground"] { z-index: 6; }
  .wander-diorama-shell[data-scene="night"] .wander-pixel-layer[data-diorama-layer="light"] { opacity: .5; }
  @keyframes wander-light-breathe { 0%, 100% { opacity: .68; } 50% { opacity: .82; } }
  @keyframes wander-dust-drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(5px, -3px, 0); } }
  .wander-diorama-shell::after { content: ""; position: absolute; inset: auto 0 0; height: 2px; background: #ffb45f; opacity: .3; pointer-events: none; }
  .wander-pixel-layer[data-diorama-layer="outside"] { animation: wander-dust-drift 18s ease-in-out alternate infinite; }
  .wander-pixel-layer[data-diorama-layer="sky"], .wander-pixel-layer[data-diorama-layer="outside"] { will-change: transform; }
  .wander-diorama-art[data-focus="anime"] .wander-pixel-layer, .wander-diorama-art[data-focus="photo"] .wander-pixel-layer, .wander-diorama-art[data-focus="notes"] .wander-pixel-layer, .wander-diorama-art[data-focus="memo"] .wander-pixel-layer { transform: translate3d(calc(var(--focus-x, 0px) * var(--layer-depth, 0)), calc(var(--focus-y, 0px) * var(--layer-depth, 0)), 0); }
  .wander-diorama-art[data-focus="anime"] .wander-pixel-layer[data-diorama-layer="objects"], .wander-diorama-art[data-focus="photo"] .wander-pixel-layer[data-diorama-layer="objects"], .wander-diorama-art[data-focus="notes"] .wander-pixel-layer[data-diorama-layer="objects"], .wander-diorama-art[data-focus="memo"] .wander-pixel-layer[data-diorama-layer="objects"] { transform: translate3d(calc(var(--parallax-x, 0px) * var(--layer-depth, 1) + var(--focus-x, 0px) * var(--layer-depth, 1)), calc(var(--parallax-y, 0px) * var(--layer-depth, 1) + var(--focus-y, 0px) * var(--layer-depth, 1)), 0) scale(1.08); }
  .wander-diorama-art[data-focus="anime"] .wander-pixel-layer[data-diorama-layer="light"], .wander-diorama-art[data-focus="photo"] .wander-pixel-layer[data-diorama-layer="light"], .wander-diorama-art[data-focus="notes"] .wander-pixel-layer[data-diorama-layer="light"], .wander-diorama-art[data-focus="memo"] .wander-pixel-layer[data-diorama-layer="light"] { opacity: .72; }
