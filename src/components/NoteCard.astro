---
import type { CollectionEntry } from "astro:content";
import { noteCategoryMeta } from "../data";

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const dateText = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(note.data.pubDate);
const categoryMeta = noteCategoryMeta[note.data.category];
const maxTags = 2;
const visibleTags = note.data.tags.slice(0, maxTags);
const hiddenTagCount = note.data.tags.length - visibleTags.length;
---

<article class="group rounded-2xl border border-zinc-200 bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-zinc-400 hover:shadow-[0_10px_24px_rgba(0,0,0,0.05)]">
  <div class="flex flex-col gap-2.5 md:flex-row md:items-start md:gap-8">
    <time class="min-w-24 pt-1 text-xs text-zinc-400" datetime={note.data.pubDate.toISOString()}>
      {dateText}
    </time>

    <div class="min-w-0 flex-1">
      <a
        href={`/notes/category/${categoryMeta.slug}/`}
        class="eyebrow transition hover:text-zinc-600"
      >
        {note.data.category}
      </a>

      <a
        href={`/notes/${note.id}/`}
        class="mt-2 block font-serif text-xl tracking-tight text-zinc-900 transition-colors group-hover:text-zinc-600"
      >
        {note.data.title}
      </a>

      <p class="mt-2 max-w-2xl text-sm leading-7 text-zinc-500">
        {note.data.description}
      </p>

      {visibleTags.length > 0 && (
        <div class="mt-3 flex flex-wrap items-center gap-1.5">
          {visibleTags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
          {hiddenTagCount > 0 && (
            <span class="text-xs text-zinc-400">+{hiddenTagCount}</span>
          )}
        </div>
      )}
    </div>
  </div>
</article>
