---
interface StatItem {
  label: string;
  value: number;
}

interface Props {
  items: StatItem[];
}

const { items } = Astro.props;
const maxValue = Math.max(...items.map((item) => item.value), 1);
---

<div class="flex flex-1 items-end gap-5">
  {items.map((item) => (
    <div class="flex flex-col items-center gap-2">
      <p class="font-serif text-xl text-zinc-900">{item.value}</p>
      <div class="flex h-14 w-2.5 items-end overflow-hidden rounded-full bg-zinc-100">
        <div
          class="reveal w-full rounded-full bg-rose-400"
          style={`height: ${Math.max(10, (item.value / maxValue) * 100)}%`}
        >
        </div>
      </div>
      <p class="eyebrow">{item.label}</p>
    </div>
  ))}
</div>
